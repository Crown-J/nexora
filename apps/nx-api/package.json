    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "db-core": "workspace:*",
    "jsonwebtoken": "^9.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.18.0",
