# apps/nx-ui/.env.example — 複製為 apps/nx-ui/.env 後依需修改值（實檔 .gitignored、勿 commit）
# 最後更新：2026-04-25

# Next.js 前端環境變數

# 執行模式（建置時寫入）
# - development 或未設定：真實登入 POST /auth/login、GET /auth/me，需後端 nx-api 運作；
#   後端資料庫請見 infra/docker/docker-compose.yml 與 packages/db-core/.env.example。
# - demo：離線展示；登入與 session 短路，不接資料庫（給客戶手機 demo 用）
#   demo 固定帳密定義於 src/features/auth/constants.ts（勿當機密；僅擋路人）
NEXT_PUBLIC_NEXORA_RUN_MODE=development

# 後端 API base URL（瀏覽器可存取）
# - 本機開發通常是 http://localhost:3001 或反向代理位址
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# NX00-API-001：前端 API client 讀取的變數名稱
NEXT_PUBLIC_API_URL=http://localhost:3001

# demo 模式可不設 NEXT_PUBLIC_API_URL（非登入的 API 呼叫會失敗，屬預期）；若需測半套串接可照填

# 認證 / 其他前端用設定可在此擴充
# 例如：
# NEXT_PUBLIC_APP_ENV=dev

# 版本號後綴（NEXORA 錯誤代碼規範 v1.2 §13）
# - beta：本機 / Railway / Vercel / 封測階段（顯示 'v1.5.0 beta'、偏黃灰）
# - 空 / unset：正式版（顯示 'v1.5.0'、amber #FFB800）
# - 首位客戶簽約後 Crown 拍板清空切換為正式版
NEXT_PUBLIC_NEXORA_VERSION_SUFFIX=beta
