# apps/nx-ui/.env.local.example — 複製為 apps/nx-ui/.env.local 後依需修改值（實檔 .gitignored、勿 commit）
# 最後更新：2026-04-25

# =============================================================================
# Demo 模式（給客戶手機示範 / 離線展示用）
# =============================================================================
# true  → 跳過後端驗證、useSessionMe 短路、用下面 NEXT_PUBLIC_DEMO_* 假 session
# false → 真實登入流程（需後端 nx-api 運作 + DB 連線）
# =============================================================================
NEXT_PUBLIC_DEMO_MODE=true

# Demo 假 session 顯示資訊（僅擋路人、勿放真機密）
NEXT_PUBLIC_DEMO_USER_NAME=範例使用者
NEXT_PUBLIC_DEMO_USER_ROLE=系統管理員
NEXT_PUBLIC_DEMO_PLAN_CODE=PRO
NEXT_PUBLIC_DEMO_TENANT_NAME=範例公司
