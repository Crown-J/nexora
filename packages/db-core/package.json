{
  "name": "db-core",
  "version": "0.0.1",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prisma:generate": "prisma generate",
    "schema:from-spec": "node scripts/generate-schema-from-spec.mjs",
    "prisma:migrate": "prisma migrate dev",
    "prisma:reset": "prisma migrate reset --force",
    "build": "tsc -p tsconfig.json",
    "import:parts2": "tsx scripts/import-parts2-csv.ts",
    "p0:railway-ddl": "pnpm exec tsx scripts/p0-railway-ddl-test.ts",
    "seed": "tsx prisma/seed/index.ts",
    "seed:system": "tsx prisma/seed/index.ts --mode system",
    "seed:test": "tsx prisma/seed/index.ts --mode test --tier all",
    "seed:test:lite": "tsx prisma/seed/index.ts --mode test --tier lite",
    "seed:test:plus": "tsx prisma/seed/index.ts --mode test --tier plus",
    "seed:test:pro": "tsx prisma/seed/index.ts --mode test --tier pro"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "^7.4.0",
    "@prisma/client-runtime-utils": "^7.5.0",
    "bcryptjs": "^3.0.3",
    "pg": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "csv-parse": "5.6.0",
    "dotenv": "^17.3.1",
    "prisma": "^7.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0"
  }
}
