  ///   - 業務員可手改此欄（不動族群）；effective = COALESCE(part.shelfLifeMonths, partGroup.defaultShelfLifeMonths)
  shelfLifeMonths                 Int?                   @map("shelf_life_months")
  tenant                          Nx99Tenant             @relation("R_Nx01Part_tenantId", fields: [tenantId], references: [id])
  country                         Nx01Country?           @relation("R_Nx01Part_countryId", fields: [countryId], references: [id])
  brand                           Nx01Brand?             @relation("R_Nx01Part_brandId", fields: [brandId], references: [id], onDelete: SetNull)
  partGroup                       Nx01PartGroup?         @relation("R_Nx01Part_partGroupId", fields: [partGroupId], references: [id])
  rev_Nx01PartRelation_partIdFrom Nx01PartRelation[]     @relation("R_Nx01PartRelation_partIdFrom")
  rev_Nx01PartRelation_partIdTo   Nx01PartRelation[]     @relation("R_Nx01PartRelation_partIdTo")
  rev_Nx02Demand_partId           Nx02Demand[]           @relation("R_Nx02Demand_partId")
  rev_Nx02PoItem_partId           Nx02PoItem[]           @relation("R_Nx02PoItem_partId")
