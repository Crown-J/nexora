  rev_Nx02PartnerPart_partId      Nx02PartnerPart[]      @relation("R_Nx02PartnerPart_partId")
  rev_Nx02WarrantyClaim_partId    Nx02WarrantyClaim[]    @relation("R_Nx02WarrantyClaim_partId")
  rev_Nx03InitItem_partId         Nx03InitItem[]         @relation("R_Nx03InitItem_partId")
  rev_Nx03PartStockSetting_partId Nx03PartStockSetting[] @relation("R_Nx03PartStockSetting_partId")
  rev_Nx03PkItem_partId           Nx03PkItem[]           @relation("R_Nx03PkItem_partId")
  rev_Nx03PlItem_partId           Nx03PlItem[]           @relation("R_Nx03PlItem_partId")
  rev_Nx03Shortage_partId         Nx03Shortage[]         @relation("R_Nx03Shortage_partId")
  rev_Nx03StItem_partId           Nx03StItem[]           @relation("R_Nx03StItem_partId")
  rev_Nx03StockBalance_partId     Nx03StockBalance[]     @relation("R_Nx03StockBalance_partId")
