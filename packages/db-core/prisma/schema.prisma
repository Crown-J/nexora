/// =======================================================
/// Nx01PhoneticDictionary — DB table `nx01_phonetic_dictionary`
/// 全域字典（無 tenantId）、SYSADMIN 維護、漢字 → 注音對照表
/// 對應規格：docs/nx01/spec/intent/nx01-10-phonetic-search.md v1.0 §4.1
/// =======================================================
model Nx01PhoneticDictionary {
  /// [NX01]+[PHDC]+[7碼流水號]，EX : NX01PHDC0000001；啟用最低需求版本：LITE
  id              String   @id @default(dbgenerated("gen_nx01_phonetic_dictionary_id()")) @db.VarChar(15)
  /// 漢字（單字元、全域 unique）；啟用最低需求版本：LITE
  character       String   @db.VarChar(4)
  /// 主要注音（如 ㄅㄧˋ）；啟用最低需求版本：LITE
  primaryPhonetic String   @map("primary_phonetic") @db.VarChar(10)
  /// 替代注音陣列（多音字、0~5 個）；啟用最低需求版本：LITE
  altPhonetics    String[] @default([]) @map("alt_phonetics")
  /// 主要聲母（從 primary_phonetic 抽出、如 ㄅ）；啟用最低需求版本：LITE
  primaryInitial  String   @map("primary_initial") @db.VarChar(2)
  /// 使用頻率（多音字優先序、系統統計）；啟用最低需求版本：LITE
  usageFreq       Int      @default(0) @map("usage_freq")
  /// 是否啟用（SYSADMIN 可停用錯字）；啟用最低需求版本：LITE
  isActive        Boolean  @default(true) @map("is_active")
  /// 建立時間；啟用最低需求版本：LITE
  createdAt       DateTime @default(now()) @map("created_at")
  /// 建立人；啟用最低需求版本：LITE
  createdBy       String   @map("created_by") @db.VarChar(15)
  /// 更新時間；啟用最低需求版本：LITE
  updatedAt       DateTime @updatedAt @map("updated_at")
  /// 更新人；啟用最低需求版本：LITE
  updatedBy       String   @map("updated_by") @db.VarChar(15)

  @@unique([character])
  @@index([primaryInitial])
  @@map("nx01_phonetic_dictionary")
}

/// =======================================================
/// Nx01PhoneticIndex — DB table `nx01_phonetic_index`
/// 跨主檔注音碼索引、trigger 維護、每租戶獨立
/// 對應規格：docs/nx01/spec/intent/nx01-10-phonetic-search.md v1.0 §4.2
/// =======================================================
model Nx01PhoneticIndex {
  /// [NX01]+[PHIX]+[7碼流水號]，EX : NX01PHIX0000001；啟用最低需求版本：LITE
  id           String     @id @default(dbgenerated("gen_nx01_phonetic_index_id()")) @db.VarChar(15)
  /// 租戶 ID；啟用最低需求版本：LITE
  tenantId     String     @map("tenant_id") @db.VarChar(15)
  /// 來源表名（如 nx01_part / nx01_partner / nx01_user）；啟用最低需求版本：LITE
  sourceTable  String     @map("source_table") @db.VarChar(50)
  /// 來源主檔 ID（軟連結、不用 FK constraint）；啟用最低需求版本：LITE
  sourceId     String     @map("source_id") @db.VarChar(15)
  /// 來源欄位名（如 name / display_name）；啟用最低需求版本：LITE
  sourceField  String     @map("source_field") @db.VarChar(50)
  /// 來源文字（快搜時顯示用）；啟用最低需求版本：LITE
  sourceText   String     @map("source_text") @db.VarChar(500)
  /// 聲母碼（如 ㄅㄓㄑ、前綴匹配用）；啟用最低需求版本：LITE
  phoneticCode String     @map("phonetic_code") @db.VarChar(50)
  /// 完整注音（如 ㄅㄧˋ ㄓㄣˋ ㄑㄧˋ、顯示用）；啟用最低需求版本：LITE
  phoneticFull String     @map("phonetic_full") @db.VarChar(200)
  /// 是否業務人員手動改（手動改後 trigger 不再覆蓋）；啟用最低需求版本：LITE
  isManual     Boolean    @default(false) @map("is_manual")
  /// 建立時間；啟用最低需求版本：LITE
  createdAt    DateTime   @default(now()) @map("created_at")
  /// 建立人（trigger=SYSADMIN ID / 手動改=該使用者）；啟用最低需求版本：LITE
  createdBy    String     @map("created_by") @db.VarChar(15)
  /// 更新時間；啟用最低需求版本：LITE
  updatedAt    DateTime   @updatedAt @map("updated_at")
  /// 更新人；啟用最低需求版本：LITE
  updatedBy    String     @map("updated_by") @db.VarChar(15)
  tenant       Nx99Tenant @relation("R_Nx01PhoneticIndex_tenantId", fields: [tenantId], references: [id])

  @@unique([tenantId, sourceTable, sourceId])
  @@index([tenantId, phoneticCode])
  @@map("nx01_phonetic_index")
}

/// =======================================================
/// Nx01Engine — DB table `nx01_engine`
/// 引擎主檔（A 主檔、車輛分類維度核心、被 NX01-13 model 引用）
/// 對應規格：docs/nx01/spec/intent/nx01-14-engine.md v1.0
/// =======================================================
model Nx01Engine {
  /// [NX01]+[ENGN]+[7碼流水號]，EX : NX01ENGN0000001；啟用最低需求版本：LITE
  id                     String        @id @default(dbgenerated("gen_nx01_engine_id()")) @db.VarChar(15)
  /// 租戶 ID；啟用最低需求版本：LITE
  tenantId               String        @map("tenant_id") @db.VarChar(15)
  /// 引擎代碼（業界縮寫 / 數字代碼、tenant 內 unique、例：EA888 / 2GR-FE / N20）；啟用最低需求版本：LITE
  code                   String        @db.VarChar(30)
  /// 引擎名稱（業務描述、可中英混、例：EA888 第三代 2.0T）；啟用最低需求版本：LITE
  name                   String        @db.VarChar(100)
  /// 排氣量 cc（EV 可空、規格 §3.2）；啟用最低需求版本：LITE
  displacementCc         Int?          @map("displacement_cc")
  /// 缸數配置（直 4 / V6 / V8 / H4 / H6、業界常用字串、EV 可空）；啟用最低需求版本：LITE
  cylinderConfig         String?       @map("cylinder_config") @db.VarChar(20)
  /// 燃料類型（1=汽油 / 2=柴油 / 3=Hybrid / 4=EV、Crown 拍 Q1=C）；啟用最低需求版本：LITE
  fuelType               Int           @default(1) @map("fuel_type") @db.SmallInt
  /// 增壓方式（1=NA 自然進氣 / 2=TC 渦輪 / 3=SC 機械 / 4=TC+SC 雙增壓、EV 可空、Crown 拍 Q2=A）；啟用最低需求版本：LITE
  aspirationType         Int?          @default(1) @map("aspiration_type") @db.SmallInt
  /// 關聯車型品牌 FK（可空、業界 EA888=VAG / 2GR=TOY / N20=BMW、跨品牌通用留空、Crown 拍 Q3=A）；啟用最低需求版本：LITE
  carBrandId             String?       @map("car_brand_id") @db.VarChar(15)
  /// 備註說明；啟用最低需求版本：LITE
  remark                 String?       @db.VarChar(200)
  /// 排序用（下拉選單顯示順序）；啟用最低需求版本：LITE
  sortNo                 Int           @default(0) @map("sort_no")
  /// 是否啟用（停用不刪資料）；啟用最低需求版本：LITE
  isActive               Boolean       @default(true) @map("is_active")
  /// 建立時間；啟用最低需求版本：LITE
  createdAt              DateTime      @default(now()) @map("created_at")
  /// 建立人；啟用最低需求版本：LITE
  createdBy              String        @map("created_by") @db.VarChar(15)
  /// 更新時間；啟用最低需求版本：LITE
  updatedAt              DateTime      @updatedAt @map("updated_at")
  /// 更新人；啟用最低需求版本：LITE
  updatedBy              String        @map("updated_by") @db.VarChar(15)
  tenant                 Nx99Tenant    @relation("R_Nx01Engine_tenantId", fields: [tenantId], references: [id])
  carBrand               Nx01CarBrand? @relation("R_Nx01Engine_carBrandId", fields: [carBrandId], references: [id])
  rev_Nx01Model_engineId Nx01Model[]   @relation("R_Nx01Model_engineId")

  @@unique([tenantId, code])
  @@index([tenantId, fuelType])
  @@map("nx01_engine")
}

/// =======================================================
/// Nx01Transmission — DB table `nx01_transmission`
/// 變速箱型錄（A 主檔複雜度、被 NX01-13 model 引用）
/// 對應規格：docs/nx01/spec/intent/nx01-15-vehicle-classification.md v1.0 §4.1
/// =======================================================
model Nx01Transmission {
  /// [NX01]+[TRMS]+[7碼流水號]；啟用最低需求版本：LITE
  id                           String        @id @default(dbgenerated("gen_nx01_transmission_id()")) @db.VarChar(15)
  /// 租戶 ID；啟用最低需求版本：LITE
  tenantId                     String        @map("tenant_id") @db.VarChar(15)
  /// 變速箱代碼（業界縮寫、tenant 內 unique、例：MT / AT / DCT / CVT / DSG7 / ZF8AT）；啟用最低需求版本：LITE
  code                         String        @db.VarChar(30)
  /// 變速箱中文名；啟用最低需求版本：LITE
  name                         String        @db.VarChar(100)
  /// 變速箱英文名（國際對照）；啟用最低需求版本：LITE
  nameEn                       String?       @map("name_en") @db.VarChar(100)
  /// 變速箱類型（1=手排 / 2=自排 / 3=雙離合 / 4=CVT / 5=AMT / 6=其他、規格 §3.2.1）；啟用最低需求版本：LITE
  transmissionType             Int           @map("transmission_type") @db.SmallInt
  /// 檔位數（手排 / 自排 / 雙離合可填、CVT 為 null）；啟用最低需求版本：LITE
  gearCount                    Int?          @map("gear_count")
  /// 關聯車型品牌 FK（可空、跨品牌通用引擎留空）；啟用最低需求版本：LITE
  carBrandId                   String?       @map("car_brand_id") @db.VarChar(15)
  /// 備註說明；啟用最低需求版本：LITE
  remark                       String?       @db.VarChar(200)
  /// 排序用（下拉顯示順序）；啟用最低需求版本：LITE
  sortNo                       Int           @default(0) @map("sort_no")
  /// 是否啟用；啟用最低需求版本：LITE
  isActive                     Boolean       @default(true) @map("is_active")
  /// 建立時間；啟用最低需求版本：LITE
  createdAt                    DateTime      @default(now()) @map("created_at")
  /// 建立人；啟用最低需求版本：LITE
  createdBy                    String        @map("created_by") @db.VarChar(15)
  /// 更新時間；啟用最低需求版本：LITE
  updatedAt                    DateTime      @updatedAt @map("updated_at")
  /// 更新人；啟用最低需求版本：LITE
  updatedBy                    String        @map("updated_by") @db.VarChar(15)
  tenant                       Nx99Tenant    @relation("R_Nx01Transmission_tenantId", fields: [tenantId], references: [id])
  carBrand                     Nx01CarBrand? @relation("R_Nx01Transmission_carBrandId", fields: [carBrandId], references: [id])
  rev_Nx01Model_transmissionId Nx01Model[]   @relation("R_Nx01Model_transmissionId")

  @@unique([tenantId, code])
  @@map("nx01_transmission")
}

/// =======================================================
/// Nx01Drivetrain — DB table `nx01_drivetrain`
/// 傳動方式型錄（B 型錄、業界 4 核心 + OWNER 自加）
/// 對應規格：docs/nx01/spec/intent/nx01-15-vehicle-classification.md v1.0 §4.2
/// =======================================================
model Nx01Drivetrain {
  /// [NX01]+[DTRN]+[7碼流水號]；啟用最低需求版本：LITE
  id                         String      @id @default(dbgenerated("gen_nx01_drivetrain_id()")) @db.VarChar(15)
  /// 租戶 ID；啟用最低需求版本：LITE
  tenantId                   String      @map("tenant_id") @db.VarChar(15)
  /// 傳動代碼（業界縮寫、tenant 內 unique、例：FF / FR / 4WD / AWD）；啟用最低需求版本：LITE
  code                       String      @db.VarChar(30)
  /// 傳動中文名；啟用最低需求版本：LITE
  name                       String      @db.VarChar(100)
  /// 傳動英文名（國際對照、Front-Engine Front-Wheel Drive 等）；啟用最低需求版本：LITE
  nameEn                     String?     @map("name_en") @db.VarChar(100)
  /// 備註說明；啟用最低需求版本：LITE
  remark                     String?     @db.VarChar(200)
  /// 排序用；啟用最低需求版本：LITE
  sortNo                     Int         @default(0) @map("sort_no")
  /// 是否啟用；啟用最低需求版本：LITE
  isActive                   Boolean     @default(true) @map("is_active")
  /// 建立時間；啟用最低需求版本：LITE
  createdAt                  DateTime    @default(now()) @map("created_at")
  /// 建立人；啟用最低需求版本：LITE
  createdBy                  String      @map("created_by") @db.VarChar(15)
  /// 更新時間；啟用最低需求版本：LITE
  updatedAt                  DateTime    @updatedAt @map("updated_at")
  /// 更新人；啟用最低需求版本：LITE
  updatedBy                  String      @map("updated_by") @db.VarChar(15)
  tenant                     Nx99Tenant  @relation("R_Nx01Drivetrain_tenantId", fields: [tenantId], references: [id])
  rev_Nx01Model_drivetrainId Nx01Model[] @relation("R_Nx01Model_drivetrainId")

  @@unique([tenantId, code])
  @@map("nx01_drivetrain")
}

/// =======================================================
/// Nx01ModelType — DB table `nx01_model_type`
/// 車體類型型錄（B 型錄、業界 5 主流 + OWNER 自加）
/// 對應規格：docs/nx01/spec/intent/nx01-15-vehicle-classification.md v1.0 §4.3
/// =======================================================
model Nx01ModelType {
  /// [NX01]+[MDTP]+[7碼流水號]；啟用最低需求版本：LITE
  id                        String      @id @default(dbgenerated("gen_nx01_model_type_id()")) @db.VarChar(15)
  /// 租戶 ID；啟用最低需求版本：LITE
  tenantId                  String      @map("tenant_id") @db.VarChar(15)
  /// 車體類型代碼（業界縮寫、tenant 內 unique、例：SED / HAT / SUV / CPE / MPV）；啟用最低需求版本：LITE
  code                      String      @db.VarChar(30)
  /// 車體類型中文名（轎車 / 掀背 / 休旅車 / 跑車 / 多功能廂式）；啟用最低需求版本：LITE
  name                      String      @db.VarChar(100)
  /// 車體類型英文名（Sedan / Hatchback / SUV / Coupe / MPV）；啟用最低需求版本：LITE
  nameEn                    String?     @map("name_en") @db.VarChar(100)
  /// 備註說明；啟用最低需求版本：LITE
  remark                    String?     @db.VarChar(200)
  /// 排序用；啟用最低需求版本：LITE
  sortNo                    Int         @default(0) @map("sort_no")
  /// 是否啟用；啟用最低需求版本：LITE
  isActive                  Boolean     @default(true) @map("is_active")
  /// 建立時間；啟用最低需求版本：LITE
  createdAt                 DateTime    @default(now()) @map("created_at")
  /// 建立人；啟用最低需求版本：LITE
  createdBy                 String      @map("created_by") @db.VarChar(15)
  /// 更新時間；啟用最低需求版本：LITE
  updatedAt                 DateTime    @updatedAt @map("updated_at")
  /// 更新人；啟用最低需求版本：LITE
  updatedBy                 String      @map("updated_by") @db.VarChar(15)
  tenant                    Nx99Tenant  @relation("R_Nx01ModelType_tenantId", fields: [tenantId], references: [id])
  rev_Nx01Model_modelTypeId Nx01Model[] @relation("R_Nx01Model_modelTypeId")

  @@unique([tenantId, code])
  @@map("nx01_model_type")
}

/// =======================================================
/// Nx01Model — DB table `nx01_model`
/// 車型主檔（A 主檔、30 年資料承接核心、被 NX01-16 part_model 戰略引用）
/// 對應規格：docs/nx01/spec/intent/nx01-13-model.md v1.0
/// =======================================================
model Nx01Model {
  /// [NX01]+[MODL]+[7碼流水號]；啟用最低需求版本：LITE
  id                                  String                    @id @default(dbgenerated("gen_nx01_model_id()")) @db.VarChar(15)
  /// 租戶 ID；啟用最低需求版本：LITE
  tenantId                            String                    @map("tenant_id") @db.VarChar(15)
  /// 車型代碼（業界縮寫、tenant 內 unique、例：G7-GTI / CAMRY-XV70 / F30）；啟用最低需求版本：LITE
  code                                String                    @db.VarChar(30)
  /// 車型全名（正式名稱、報表/客戶單據用、例：Golf 7 GTI）；啟用最低需求版本：LITE
  name                                String                    @db.VarChar(100)
  /// 車型品牌 FK（必填、規格 §3.2 Crown Q3=A）；啟用最低需求版本：LITE
  carBrandId                          String                    @map("car_brand_id") @db.VarChar(15)
  /// 起始年份（必填、業務檢核 ≥ 1900 + ≤ 當前年+5、規格 §3.3）；啟用最低需求版本：LITE
  modelYearFrom                       Int                       @map("model_year_from")
  /// 結束年份（可空、現役留空、若填必 ≥ modelYearFrom、規格 §3.3）；啟用最低需求版本：LITE
  modelYearTo                         Int?                      @map("model_year_to")
  /// 引擎 FK（可空、Crown 業界 muscle memory：詳細分類進階用戶選填）；啟用最低需求版本：LITE
  engineId                            String?                   @map("engine_id") @db.VarChar(15)
  /// 變速箱 FK（可空）；啟用最低需求版本：LITE
  transmissionId                      String?                   @map("transmission_id") @db.VarChar(15)
  /// 傳動方式 FK（可空）；啟用最低需求版本：LITE
  drivetrainId                        String?                   @map("drivetrain_id") @db.VarChar(15)
  /// 車體類型 FK（可空）；啟用最低需求版本：LITE
  modelTypeId                         String?                   @map("model_type_id") @db.VarChar(15)
  /// 備註說明；啟用最低需求版本：LITE
  remark                              String?                   @db.VarChar(200)
  /// 排序用；啟用最低需求版本：LITE
  sortNo                              Int                       @default(0) @map("sort_no")
  /// 是否啟用；啟用最低需求版本：LITE
  isActive                            Boolean                   @default(true) @map("is_active")
  /// 建立時間；啟用最低需求版本：LITE
  createdAt                           DateTime                  @default(now()) @map("created_at")
  /// 建立人；啟用最低需求版本：LITE
  createdBy                           String                    @map("created_by") @db.VarChar(15)
  /// 更新時間；啟用最低需求版本：LITE
  updatedAt                           DateTime                  @updatedAt @map("updated_at")
  /// 更新人；啟用最低需求版本：LITE
  updatedBy                           String                    @map("updated_by") @db.VarChar(15)
  tenant                              Nx99Tenant                @relation("R_Nx01Model_tenantId", fields: [tenantId], references: [id])
  carBrand                            Nx01CarBrand              @relation("R_Nx01Model_carBrandId", fields: [carBrandId], references: [id])
  engine                              Nx01Engine?               @relation("R_Nx01Model_engineId", fields: [engineId], references: [id])
  transmission                        Nx01Transmission?         @relation("R_Nx01Model_transmissionId", fields: [transmissionId], references: [id])
  drivetrain                          Nx01Drivetrain?           @relation("R_Nx01Model_drivetrainId", fields: [drivetrainId], references: [id])
  modelType                           Nx01ModelType?            @relation("R_Nx01Model_modelTypeId", fields: [modelTypeId], references: [id])
  rev_Nx01PartModel_modelId           Nx01PartModel[]           @relation("R_Nx01PartModel_modelId")
  rev_Nx03BrandAllocationRule_modelId Nx03BrandAllocationRule[] @relation("R_Nx03BrandAllocationRule_modelId")

  @@unique([tenantId, code])
  @@index([tenantId, carBrandId])
  @@index([tenantId, modelYearFrom])
  @@map("nx01_model")
}

/// =======================================================
/// Nx01PartVersion — DB table `nx01_part_version`
/// 料號版本紀錄（全 snapshot 範式、Q1=A 拍板）
/// 對應規格：docs/nx01/spec/intent/nx01-17-part-version-relation.md v1.0
/// =======================================================
model Nx01PartVersion {
  /// [NX01]+[PAVE]+[7碼流水號]；啟用最低需求版本：LITE
  id            String    @id @default(dbgenerated("gen_nx01_part_version_id()")) @db.VarChar(15)
  /// 租戶 ID；啟用最低需求版本：LITE
  tenantId      String    @map("tenant_id") @db.VarChar(15)
  /// 對應 part FK；啟用最低需求版本：LITE
  partId        String    @map("part_id") @db.VarChar(15)
  /// 版本號（每 part 從 1 起算、連續編號）；啟用最低需求版本：LITE
  versionNo     Int       @map("version_no")
  /// 生效起始日；啟用最低需求版本：LITE
  effectiveFrom DateTime  @map("effective_from")
  /// 結束日（nullable、現役留空）；啟用最低需求版本:LITE
  effectiveTo   DateTime? @map("effective_to")

  /// 完整 snapshot 9 欄位（Q1=A 拍板：每次 part update 完整 copy）
  codeSnapshot        String   @map("code_snapshot") @db.VarChar(50)
  nameSnapshot        String   @map("name_snapshot") @db.VarChar(200)
  partBrandIdSnapshot String?  @map("part_brand_id_snapshot") @db.VarChar(15)
  countryIdSnapshot   String?  @map("country_id_snapshot") @db.VarChar(15)
  specSnapshot        String?  @map("spec_snapshot") @db.VarChar(200)
  priceASnapshot      Decimal? @map("price_a_snapshot") @db.Decimal(14, 4)
  priceBSnapshot      Decimal? @map("price_b_snapshot") @db.Decimal(14, 4)
  priceCSnapshot      Decimal? @map("price_c_snapshot") @db.Decimal(14, 4)
  priceDSnapshot      Decimal? @map("price_d_snapshot") @db.Decimal(14, 4)

  /// 變動原因（業務人員填、稽核用）；啟用最低需求版本：LITE
  changeReason                           String?                @map("change_reason") @db.VarChar(500)
  /// 建立時間；啟用最低需求版本：LITE
  createdAt                              DateTime               @default(now()) @map("created_at")
  /// 建立人；啟用最低需求版本：LITE
  createdBy                              String                 @map("created_by") @db.VarChar(15)
  /// 更新時間；啟用最低需求版本：LITE
  updatedAt                              DateTime               @updatedAt @map("updated_at")
  /// 更新人；啟用最低需求版本：LITE
  updatedBy                              String                 @map("updated_by") @db.VarChar(15)
  tenant                                 Nx99Tenant             @relation("R_Nx01PartVersion_tenantId", fields: [tenantId], references: [id])
  part                                   Nx01Part               @relation("R_Nx01PartVersion_partId", fields: [partId], references: [id])
  rev_Nx03StockLedger_partVersionId      Nx03StockLedger[]      @relation("R_Nx03StockLedger_partVersionId")
  rev_Nx03InitItem_partVersionId         Nx03InitItem[]         @relation("R_Nx03InitItem_partVersionId")
  rev_Nx03StItem_partVersionId           Nx03StItem[]           @relation("R_Nx03StItem_partVersionId")
  rev_Nx03StockTakeItem_partVersionId    Nx03StockTakeItem[]    @relation("R_Nx03StockTakeItem_partVersionId")
  rev_Nx03DisposalItem_partVersionId     Nx03DisposalItem[]     @relation("R_Nx03DisposalItem_partVersionId")
  rev_Nx03ConversionInput_partVersionId  Nx03ConversionInput[]  @relation("R_Nx03ConversionInput_partVersionId")
  rev_Nx03ConversionOutput_partVersionId Nx03ConversionOutput[] @relation("R_Nx03ConversionOutput_partVersionId")

  @@unique([tenantId, partId, versionNo])
  @@index([tenantId, partId])
  @@index([tenantId, effectiveFrom])
  @@map("nx01_part_version")
}

/// =======================================================
/// Nx01PartModel — DB table `nx01_part_model`
/// 料號車型適配（A 主檔、戰略表 ⭐⭐、Yaro 30 年知識結構化核心）
/// 對應規格：docs/nx01/spec/intent/nx01-16-part-model.md v1.0
/// =======================================================
model Nx01PartModel {
  /// [NX01]+[PAMO]+[7碼流水號]，EX : NX01PAMO0000001；啟用最低需求版本：LITE
  id        String     @id @default(dbgenerated("gen_nx01_part_model_id()")) @db.VarChar(15)
  /// 租戶 ID；啟用最低需求版本：LITE
  tenantId  String     @map("tenant_id") @db.VarChar(15)
  /// 料件 FK（必填、規格 §3.2 Q1=A）；啟用最低需求版本：LITE
  partId    String     @map("part_id") @db.VarChar(15)
  /// 車型 FK（必填、規格 §3.2 Q1=A）；啟用最低需求版本：LITE
  modelId   String     @map("model_id") @db.VarChar(15)
  /// 適配等級（1=原廠 / 2=副廠等效 / 3=通用替代、Q3=B SmallInt enum）；啟用最低需求版本：LITE
  fitLevel  Int        @default(1) @map("fit_level") @db.SmallInt
  /// 備註說明（業務人員手記）；啟用最低需求版本：LITE
  remark    String?    @db.VarChar(200)
  /// 排序用；啟用最低需求版本：LITE
  sortNo    Int        @default(0) @map("sort_no")
  /// 是否啟用；啟用最低需求版本：LITE
  isActive  Boolean    @default(true) @map("is_active")
  /// 建立時間；啟用最低需求版本：LITE
  createdAt DateTime   @default(now()) @map("created_at")
  /// 建立人；啟用最低需求版本：LITE
  createdBy String     @map("created_by") @db.VarChar(15)
  /// 更新時間；啟用最低需求版本：LITE
  updatedAt DateTime   @updatedAt @map("updated_at")
  /// 更新人；啟用最低需求版本：LITE
  updatedBy String     @map("updated_by") @db.VarChar(15)
  tenant    Nx99Tenant @relation("R_Nx01PartModel_tenantId", fields: [tenantId], references: [id])
  part      Nx01Part   @relation("R_Nx01PartModel_partId", fields: [partId], references: [id])
  model     Nx01Model  @relation("R_Nx01PartModel_modelId", fields: [modelId], references: [id])

  @@unique([tenantId, partId, modelId])
  @@index([tenantId, partId])
  @@index([tenantId, modelId])
  @@map("nx01_part_model")
}
