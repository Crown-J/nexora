  qty                     Decimal      @default(0) @db.Decimal(14, 4)
  /// 單位成本（原始單價：國內 = TWD 直接成本、國外 = 外幣單價未換匯）。LITE 階段 1 語意收斂：跟 actualUnitCost 分離、TWD 換匯+進口費攤分後寫入 actualUnitCost；啟用最低需求版本：LITE
  unitCost                Decimal      @default(0) @map("unit_cost") @db.Decimal(14, 4)
  /// 原始外幣單價（國內 = TWD 跟 unitCost 同值、國外 = 換匯前外幣值）。審計留底用、跟 unitCost 並存。LITE 階段 1 新加；啟用最低需求版本：LITE-CORE
  originalUnitCost        Decimal      @default(0) @map("original_unit_cost") @db.Decimal(14, 4)
  /// 攤分到此 item 的進口費用（按金額比例：額外費用總額 × (該零件貨款 ÷ 批內總貨款)、國內 = 0）。LITE 階段 1 新加；啟用最低需求版本：LITE-CORE
  allocatedImportFee      Decimal      @default(0) @map("allocated_import_fee") @db.Decimal(14, 2)
  /// 實際入庫成本（TWD、含換匯+進口費攤分）= (originalUnitCost × exchangeRate × qty + allocatedImportFee) ÷ qty。過帳 applyQtyInWithLedger 用此值算移動平均。LITE 階段 1 新加；啟用最低需求版本：LITE-CORE
  actualUnitCost          Decimal      @default(0) @map("actual_unit_cost") @db.Decimal(14, 4)
  /// 明細金額（qty * unit_cost）；啟用最低需求版本：LITE
  lineAmount              Decimal      @default(0) @map("line_amount") @db.Decimal(14, 2)
  /// 備註；啟用最低需求版本：LITE
  remark                  String?      @db.VarChar(200)
  /// 建立時間。；啟用最低需求版本：LITE
  createdAt               DateTime     @default(now()) @map("created_at")
  /// 建立人（必填；系統操作帶入使用者 ID；DB 匯入填系統管理員 ID）；啟用最低需求版本：LITE
  createdBy               String       @map("created_by") @db.VarChar(15)
  /// 更新時間。；啟用最低需求版本：LITE
  updatedAt               DateTime     @updatedAt @map("updated_at")
  /// 更新人（必填；系統操作帶入使用者 ID；DB 匯入填系統管理員 ID）；啟用最低需求版本：LITE
  updatedBy               String       @map("updated_by") @db.VarChar(15)
  /// 預計到貨數量（建立進貨單時填入）。；啟用最低需求版本：LITE-CORE
  expectedQty             Decimal      @default(0) @map("expected_qty") @db.Decimal(14, 4)
  /// 實際到貨數量（驗收後填入）。；啟用最低需求版本：LITE-CORE
  actualQty               Decimal?     @map("actual_qty") @db.Decimal(14, 4)
  /// 瑕疵品數量（驗收發現時填入，預設0）。；啟用最低需求版本：LITE-CORE
  defectQty               Decimal      @default(0) @map("defect_qty") @db.Decimal(14, 4)
  /// 瑕疵類型（D=外觀損壞/F=功能異常/W=規格不符/O=其他）。defect_qty>0時必填。；啟用最低需求版本：LITE-CORE
  defectType              String?      @map("defect_type") @db.VarChar(1)
  /// 瑕疵描述（defect_qty>0時必填）。；啟用最低需求版本：LITE-CORE
  defectDesc              String?      @map("defect_desc") @db.VarChar(200)
  /// 批號（進貨年月+流水，如202604001），供保固追蹤與退貨驗證使用。；啟用最低需求版本：LITE-CORE
  batchNo                 String?      @map("batch_no") @db.VarChar(30)
  /// 保固到期日（依nx02_part.warranty_months計算：rr_date + warranty_months）。warranty_months=0時為空。；啟用最低需求版本：LITE-CORE
  warrantyExpiredAt       DateTime?    @map("warranty_expired_at") @db.Date
  rr                      Nx02Rr       @relation("R_Nx02RrItem_rrId", fields: [rrId], references: [id])
  part                    Nx01Part     @relation("R_Nx02RrItem_partId", fields: [partId], references: [id])
  location                Nx01Location @relation("R_Nx02RrItem_locationId", fields: [locationId], references: [id])
  rev_Nx02PrItem_rrItemId Nx02PrItem[] @relation("R_Nx02PrItem_rrItemId")

  @@map("nx02_rr_item")
