/// =======================================================
/// Nx04Quote — DB table `nx04_quote`
/// =======================================================
model Nx04Quote {
  /// [NX04]+[QTHD]+[7碼流水號]，EX : NX04QTHD0000001；啟用最低需求版本：LITE-CORE
  id                        String             @id @default(dbgenerated("gen_nx04_quote_id()")) @db.VarChar(15)
