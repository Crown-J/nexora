  issueDescription                        String                        @map("issue_description") @db.VarChar(1000)
  /// 狀態（D=DRAFT 草稿/S=SUBMITTED 已送出/R=REVIEWING 供應商審核中/C=COMPLETED 已完成有審核結果/V=VOIDED 作廢）；啟用最低需求版本：LITE
  status                                  String                        @default("D") @db.VarChar(1)
  /// 審核結果（status=C 才有值：NEW=換新/REF=退錢/RPR=維修後還/REJ=駁回、null=尚未審核）；啟用最低需求版本：LITE
  result                                  String?                       @db.VarChar(3)
