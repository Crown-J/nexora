// =============================================================================
// NEXORA GRID — Prisma Schema（docs/spec 欄位表驅動）
// =============================================================================
// 產生：node scripts/generate-schema-from-spec.mjs（packages/db-core）
// 規格來源：
//   - docs/spec/nx01_field_v1.csv … nx10_field_v1.csv、nx98、nx99
//   - docs/spec/nx_table_v7.csv（表清單／模組／說明）
//   - docs/spec/nx_model_v2.csv（模組定義）
//   - docs/spec/version_plan.csv、version_feature_matrix.csv（方案與功能）
//
// 命名：Prisma camelCase；DB snake_case @map；表 nx{模組}_{實體}；Model Nx{模組}{PascalCase}。
// ID：VARCHAR(15)，dbgenerated("gen_{table}_id()") — 首包 migration 已內建 seq + gen_*（見 scripts/generate-gen-id-sql.mjs）。
// 欄位 ///：含 CSV「欄位說明」+「啟用最低需求版本」（LITE / PLUS / PRO 等級距標示如 LITE-CORE、PRO）。
// 租戶：業務表 tenant_id；NX99 為系統層（無租戶欄位）。
// 審計：created_by／updated_by 等指向 nx01_user 僅 scalar，不建立 Relation（避免 Nx01User 反向關聯過大）。
// 其餘 FK：雙向 @relation，名稱 R_{FromModel}_{fkFieldCamel}；反向欄位 rev_{FromModel}_{fkFieldCamel}。
//
// 產生器修正（CSV 與實際模組對齊）：
// - nx02_part / nx02_partner / nx02_warehouse / nx02_currency / nx02_location → nx01_* 主檔表
// - nx01_rr → nx02_rr（進貨單屬採購模組）
// - 主鍵 id：規格常將 GEN 寫在「欄位說明」；凡 PK 欄位 id 一律 dbgenerated(gen_{table}_id())
// - 欄位表尚未提供的表（例：nx01_employee）：指向該表的 FK 僅輸出 scalar，不產生 @relation
// =============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// =======================================================
/// Nx01AuditLog — DB table `nx01_audit_log`
/// =======================================================
model Nx01AuditLog {
  /// [NX01]+[AULO]+[7碼流水號]，EX : NX01AULO0000001；啟用最低需求版本：LITE
  id          String     @id @default(dbgenerated("gen_nx01_audit_log_id()")) @db.VarChar(15)
  /// 租戶 ID（外鍵）；啟用最低需求版本：LITE
  tenantId    String     @map("tenant_id") @db.VarChar(15)
  /// 發生時間；啟用最低需求版本：LITE
  occurredAt  DateTime   @default(now()) @map("occurred_at")
  /// 操作者（使用者 ID）；啟用最低需求版本：LITE
  actorUserId String     @map("actor_user_id") @db.VarChar(15)
  /// 模組代碼：nx00/nx01/nx02...；啟用最低需求版本：LITE
  moduleCode  String     @map("module_code") @db.VarChar(10)
  /// 動作類型：CREATE/UPDATE/DELETE/LOGIN/LOGOUT/EXPORT/POST/VOID…；啟用最低需求版本：LITE
  action      String     @db.VarChar(20)
  /// 目標表格名稱，例：nx01_po、nx01_part；啟用最低需求版本：LITE
  entityTable String     @map("entity_table") @db.VarChar(50)
  /// 目標資料 ID（多數是 VARCHAR(15)，允許更長避免未來擴充）；啟用最低需求版本：LITE
  entityId    String?    @map("entity_id") @db.VarChar(20)
  /// 目標資料識別碼（例：單號、料號、畫面代碼），方便人查；啟用最低需求版本：LITE
  entityCode  String?    @map("entity_code") @db.VarChar(50)
  /// 簡述（例：建立進貨單、修改銷貨單金額）；啟用最低需求版本：LITE
  summary     String?    @db.VarChar(200)
  /// 變更前資料快照（可空；只在 UPDATE/DELETE 時有）；啟用最低需求版本：LITE
  beforeData  Json?      @map("before_data")
  /// 變更後資料快照（可空；只在 CREATE/UPDATE 時有）；啟用最低需求版本：LITE
  afterData   Json?      @map("after_data")
  /// IP 位址（IPv4/IPv6；可空）；啟用最低需求版本：LITE
  ipAddr      String?    @map("ip_addr") @db.VarChar(45)
  /// 瀏覽器/裝置資訊（可空）；啟用最低需求版本：LITE
  userAgent   String?    @map("user_agent") @db.VarChar(200)
  tenant      Nx99Tenant @relation("R_Nx01AuditLog_tenantId", fields: [tenantId], references: [id])

  @@map("nx01_audit_log")
}

/// =======================================================
/// Nx01BrandCodeRule — DB table `nx01_brand_code_rule`
/// =======================================================
model Nx01BrandCodeRule {
  /// [NX01]+[BCOR]+[7碼流水號]，EX : NX01BCOR0000001；啟用最低需求版本：LITE
  id                      String       @id @default(dbgenerated("gen_nx01_brand_code_rule_id()")) @db.VarChar(15)
  /// 租戶 ID（外鍵）；啟用最低需求版本：LITE
  tenantId                String       @map("tenant_id") @db.VarChar(15)
  /// 車型品牌 ID（FK Nx01CarBrand、一個品牌只有一筆規則、規格 v1.0 §1.3）；啟用最低需求版本：LITE
  carBrandId              String       @map("car_brand_id") @db.VarChar(15)
  /// 規則名稱（描述用）；啟用最低需求版本：LITE
  name                    String       @db.VarChar(50)
  /// 規則描述；啟用最低需求版本：LITE
  description             String?      @db.VarChar(200)
  /// SEG 數量（1~10）；啟用最低需求版本：LITE
  segCount                Int          @default(5) @map("seg_count")
  /// SEG 定義陣列（JSON、每筆含 seg_no/name/length_min/length_max/charset/required/description、規格 §4.2）；啟用最低需求版本：LITE
  segDefinitions          Json         @map("seg_definitions")
  /// SEG 分隔符（如 · / - / 空白、tenant 可改、規格 §5.3）；啟用最低需求版本：LITE
  separator               String       @default("·") @db.VarChar(1)
  /// 來源代碼前綴（預設 #、tenant 可改）；啟用最低需求版本：LITE
  sourceCodePrefix        String       @default("#") @map("source_code_prefix") @db.VarChar(1)
  /// 來源代碼結構（v1.0 固定 BRAND3+COUNTRY3）；啟用最低需求版本：LITE
  sourceCodeFormat        String       @default("BRAND3+COUNTRY3") @map("source_code_format") @db.VarChar(30)
  /// 範例 part_code_2（UI 預覽用、規格 §2.2）；啟用最低需求版本：LITE
  examplePartCode         String?      @map("example_part_code") @db.VarChar(100)
  /// 是否啟用；啟用最低需求版本：LITE
  isActive                Boolean      @default(true) @map("is_active")
  /// 建立時間。；啟用最低需求版本：LITE
  createdAt               DateTime     @default(now()) @map("created_at")
  /// 建立人（必填；系統操作帶入使用者 ID；DB 匯入填系統管理員 ID）；啟用最低需求版本：LITE
  createdBy               String       @map("created_by") @db.VarChar(15)
  /// 更新時間。；啟用最低需求版本：LITE
  updatedAt               DateTime     @updatedAt @map("updated_at")
  /// 更新人（必填；系統操作帶入使用者 ID；DB 匯入填系統管理員 ID）；啟用最低需求版本：LITE
  updatedBy               String       @map("updated_by") @db.VarChar(15)
  tenant                  Nx99Tenant   @relation("R_Nx01BrandCodeRule_tenantId", fields: [tenantId], references: [id])
  carBrand                Nx01CarBrand @relation("R_Nx01BrandCodeRule_carBrandId", fields: [carBrandId], references: [id])
  rev_Nx01Part_codeRuleId Nx01Part[]   @relation("R_Nx01Part_codeRuleId")

  @@unique([tenantId, carBrandId])
  @@map("nx01_brand_code_rule")
}

/// =======================================================
/// Nx01Bulletin — DB table `nx01_bulletin`
/// =======================================================
model Nx01Bulletin {
  /// [NX01]+[BULL]+[7碼流水號]，EX : NX01BULL0000001；啟用最低需求版本：LITE
  id              String                   @id @default(dbgenerated("gen_nx01_bulletin_id()")) @db.VarChar(15)
  /// 租戶 ID（外鍵）；啟用最低需求版本：LITE
  tenantId        String                   @map("tenant_id") @db.VarChar(15)
  /// 公告標題；啟用最低需求版本：LITE
  title           String                   @db.VarChar(100)
  /// 公告內容（rich text、HTML 5000 字內）；啟用最低需求版本：LITE
  content         String?                  @db.Text
  /// 公告類型（v0 遺留：S=SYSTEM / C=COMPANY / R=REMIND）。v1.0 改用 category_id；本欄位保留 backward compat、後續 task 廢棄。
  type            String                   @default("C") @db.VarChar(1)
  /// 分類 FK（連 nx01_bulletin_category、v1.0 對齊 audience_logic 對象範圍）；啟用最低需求版本：LITE
  categoryId      String?                  @map("category_id") @db.VarChar(15)
  /// 重要等級：normal=一般 / important=重要（第一次登入跳 modal） / urgent=緊急（每次登入跳）；啟用最低需求版本：LITE
  importance      String                   @default("normal") @db.VarChar(20)
  /// 補充指定 user IDs（在 category 對象範圍外、額外加掛指定 user）；啟用最低需求版本：LITE
  audienceUserIds String[]                 @map("audience_user_ids") @db.VarChar(15)
  /// 發布時間（預設 now、PRO 可排程未來）；啟用最低需求版本：LITE
  publishAt       DateTime                 @default(now()) @map("publish_at")
  /// 狀態：draft=草稿 / scheduled=排程中 / published=已發布 / withdrawn=撤回 / expired=過期；啟用最低需求版本：LITE
  status          String                   @default("draft") @db.VarChar(20)
  /// 是否置頂（v0 遺留欄位、保留 backward compat、v1.0 spec 未提）；啟用最低需求版本：LITE
  isPinned        Boolean                  @default(false) @map("is_pinned")
  /// 到期時間（NULL = 永久顯示）；啟用最低需求版本：LITE
  expiredAt       DateTime?                @map("expired_at")
  /// 已讀人數（trigger 自動更新、來自 nx01_bulletin_read_log count）；啟用最低需求版本：LITE
  readCount       Int                      @default(0) @map("read_count")
  /// 是否啟用；啟用最低需求版本：LITE
  isActive        Boolean                  @default(true) @map("is_active")
  /// 建立時間。；啟用最低需求版本：LITE
  createdAt       DateTime                 @default(now()) @map("created_at")
  /// 建立人（必填；系統操作帶入使用者 ID；DB 匯入填系統管理員 ID）；啟用最低需求版本：LITE
  createdBy       String                   @map("created_by") @db.VarChar(15)
  /// 更新時間。；啟用最低需求版本：LITE
  updatedAt       DateTime                 @updatedAt @map("updated_at")
  /// 更新人（必填；系統操作帶入使用者 ID；DB 匯入填系統管理員 ID）；啟用最低需求版本：LITE
  updatedBy       String                   @map("updated_by") @db.VarChar(15)
  tenant          Nx99Tenant               @relation("R_Nx01Bulletin_tenantId", fields: [tenantId], references: [id])
  category        Nx01BulletinCategory?    @relation("R_Nx01Bulletin_categoryId", fields: [categoryId], references: [id])
  rev_Attachment  Nx01BulletinAttachment[] @relation("R_Nx01BulletinAttachment_bulletinId")
  rev_ReadLog     Nx01BulletinReadLog[]    @relation("R_Nx01BulletinReadLog_bulletinId")

  @@map("nx01_bulletin")
}

/// =======================================================
/// Nx01BulletinCategory — DB table `nx01_bulletin_category`
/// 公告分類表（v1.0 子表、Tier 差異走 tier_required 不寫死 enum）
/// =======================================================
model Nx01BulletinCategory {
  /// [NX01]+[BCAT]+[7碼流水號]，EX : NX01BCAT0000001；啟用最低需求版本：LITE
  id            String         @id @default(dbgenerated("gen_nx01_bulletin_category_id()")) @db.VarChar(15)
  /// 租戶 ID（外鍵）；啟用最低需求版本：LITE
  tenantId      String         @map("tenant_id") @db.VarChar(15)
  /// 分類代碼（all / system / mgmt / product / sales / warehouse / finance / 自訂）；啟用最低需求版本：LITE
  code          String         @db.VarChar(30)
  /// 分類名稱（顯示用）；啟用最低需求版本：LITE
  name          String         @db.VarChar(50)
  /// 對象範圍邏輯 enum（tenant_all / system_all / leaders_all / by_team_id）；啟用最低需求版本：LITE
  audienceLogic String         @map("audience_logic") @db.VarChar(20)
  /// 對應 team FK（audience_logic = by_team_id 時必填）；啟用最低需求版本：PLUS
  teamId        String?        @map("team_id") @db.VarChar(15)
  /// 此分類所需最低 Tier（LITE / PLUS / PRO）；啟用最低需求版本：LITE
  tierRequired  String         @default("LITE") @map("tier_required") @db.VarChar(10)
  /// 是否系統預設（true = 不可刪、false = user 自訂）；啟用最低需求版本：LITE
  isSystem      Boolean        @default(false) @map("is_system")
  /// 排序；啟用最低需求版本：LITE
  sortOrder     Int            @default(0) @map("sort_order")
  /// 是否啟用；啟用最低需求版本：LITE
  isActive      Boolean        @default(true) @map("is_active")
  /// 建立時間。；啟用最低需求版本：LITE
  createdAt     DateTime       @default(now()) @map("created_at")
  /// 建立人；啟用最低需求版本：LITE
  createdBy     String         @map("created_by") @db.VarChar(15)
  /// 更新時間。；啟用最低需求版本：LITE
  updatedAt     DateTime       @updatedAt @map("updated_at")
  /// 更新人；啟用最低需求版本：LITE
  updatedBy     String         @map("updated_by") @db.VarChar(15)
  tenant        Nx99Tenant     @relation("R_Nx01BulletinCategory_tenantId", fields: [tenantId], references: [id])
  team          Nx01Team?      @relation("R_Nx01BulletinCategory_teamId", fields: [teamId], references: [id])
  rev_Bulletin  Nx01Bulletin[] @relation("R_Nx01Bulletin_categoryId")

  @@unique([tenantId, code])
  @@map("nx01_bulletin_category")
}

/// =======================================================
/// Nx01BulletinAttachment — DB table `nx01_bulletin_attachment`
/// 公告附件子表（v1.0 範式 C、接軌 1 file-upload service、storage_key 跨 backend 通用）
/// =======================================================
model Nx01BulletinAttachment {
  /// [NX01]+[BATT]+[7碼流水號]，EX : NX01BATT0000001；啟用最低需求版本：LITE
  id             String       @id @default(dbgenerated("gen_nx01_bulletin_attachment_id()")) @db.VarChar(15)
  /// 租戶 ID（外鍵、軌 1 FileUploadService.upload() tenantId prefix 強制驗證對齊）；啟用最低需求版本：LITE
  tenantId       String       @map("tenant_id") @db.VarChar(15)
  /// 公告 FK；啟用最低需求版本：LITE
  bulletinId     String       @map("bulletin_id") @db.VarChar(15)
  /// 檔案在 storage 的 key（範式：{tenantId}/{module}/{yyyy}/{mm}/{uuid}{ext}、階段 1 本地路徑、階段 2 R2 object key）；啟用最低需求版本：LITE
  storageKey     String       @map("storage_key") @db.VarChar(500)
  /// MIME 類型（application/pdf / image/png 等）；啟用最低需求版本：LITE
  mimeType       String       @map("mime_type") @db.VarChar(100)
  /// 檔案大小（bytes）；啟用最低需求版本：LITE
  fileSize       Int          @map("file_size")
  /// 上傳時原始檔名；啟用最低需求版本：LITE
  origFilename   String       @map("orig_filename") @db.VarChar(255)
  /// 上傳者 FK；啟用最低需求版本：LITE
  uploaderUserId String       @map("uploader_user_id") @db.VarChar(15)
  /// 上傳時間；啟用最低需求版本：LITE
  createdAt      DateTime     @default(now()) @map("created_at")
  tenant         Nx99Tenant   @relation("R_Nx01BulletinAttachment_tenantId", fields: [tenantId], references: [id])
  bulletin       Nx01Bulletin @relation("R_Nx01BulletinAttachment_bulletinId", fields: [bulletinId], references: [id], onDelete: Cascade)
  uploader       Nx01User     @relation("R_Nx01BulletinAttachment_uploaderUserId", fields: [uploaderUserId], references: [id])

  @@index([bulletinId])
  @@map("nx01_bulletin_attachment")
}

/// =======================================================
/// Nx01BulletinReadLog — DB table `nx01_bulletin_read_log`
/// 公告已讀紀錄（v1.0 § 4.4、PK = (bulletin_id, user_id) 同 user 對同公告只記一筆）
/// =======================================================
model Nx01BulletinReadLog {
  /// [NX01]+[BRLG]+[7碼流水號]，EX : NX01BRLG0000001；啟用最低需求版本：LITE
  id             String       @id @default(dbgenerated("gen_nx01_bulletin_read_log_id()")) @db.VarChar(15)
  /// 租戶 ID（外鍵）；啟用最低需求版本：LITE
  tenantId       String       @map("tenant_id") @db.VarChar(15)
  /// 公告 FK；啟用最低需求版本：LITE
  bulletinId     String       @map("bulletin_id") @db.VarChar(15)
  /// 已讀者 FK；啟用最低需求版本：LITE
  userId         String       @map("user_id") @db.VarChar(15)
  /// 已讀時間；啟用最低需求版本：LITE
  readAt         DateTime     @default(now()) @map("read_at")
  /// 閱讀時間（modal 開啟 → 點「我已閱讀」毫秒數）；啟用最低需求版本：LITE
  readDurationMs Int?         @map("read_duration_ms")
  tenant         Nx99Tenant   @relation("R_Nx01BulletinReadLog_tenantId", fields: [tenantId], references: [id])
  bulletin       Nx01Bulletin @relation("R_Nx01BulletinReadLog_bulletinId", fields: [bulletinId], references: [id], onDelete: Cascade)
  user           Nx01User     @relation("R_Nx01BulletinReadLog_userId", fields: [userId], references: [id])

  @@unique([bulletinId, userId])
  @@index([userId])
  @@map("nx01_bulletin_read_log")
}

/// =======================================================
/// Nx01CalendarEvent — DB table `nx01_calendar_event`
/// =======================================================
model Nx01CalendarEvent {
  /// [NX01]+[CAEV]+[7碼流水號]，EX : NX01CAEV0000001；啟用最低需求版本：LITE
  id         String     @id @default(dbgenerated("gen_nx01_calendar_event_id()")) @db.VarChar(15)
  /// 租戶 ID（外鍵）；啟用最低需求版本：LITE
  tenantId   String     @map("tenant_id") @db.VarChar(15)
  /// 事件標題；啟用最低需求版本：LITE
  title      String     @db.VarChar(100)
  /// 事件類型：S=SYSTEM / C=COMPANY / R=REMIND；啟用最低需求版本：LITE
  type       String     @db.VarChar(1)
  /// 開始時間；啟用最低需求版本：LITE
  dateStart  DateTime   @map("date_start")
  /// 結束時間；啟用最低需求版本：LITE
  dateEnd    DateTime   @map("date_end")
  /// 是否整天；啟用最低需求版本：LITE
  isAllDay   Boolean    @default(false) @map("is_all_day")
  /// 相關單據類型：RF=詢價單 / PO=採購單 / RR=進貨單 / RM=退貨單 / QT=報價單 / SO=銷貨單 / SR=銷退單；啟用最低需求版本：LITE
  orderType  String?    @map("order_type") @db.VarChar(2)
  /// 單據單號 (依 order_type 動態對應)；啟用最低需求版本：LITE
  orderDocNo String?    @map("order_doc_no") @db.VarChar(30)
  /// 是否啟用；啟用最低需求版本：LITE
  isActive   Boolean    @default(true) @map("is_active")
  /// 建立時間。；啟用最低需求版本：LITE
  createdAt  DateTime   @default(now()) @map("created_at")
  /// 建立人（必填；系統操作帶入使用者 ID；DB 匯入填系統管理員 ID）；啟用最低需求版本：LITE
  createdBy  String     @map("created_by") @db.VarChar(15)
  /// 更新時間。；啟用最低需求版本：LITE
  updatedAt  DateTime   @updatedAt @map("updated_at")
  /// 更新人（必填；系統操作帶入使用者 ID；DB 匯入填系統管理員 ID）；啟用最低需求版本：LITE
  updatedBy  String     @map("updated_by") @db.VarChar(15)
  tenant     Nx99Tenant @relation("R_Nx01CalendarEvent_tenantId", fields: [tenantId], references: [id])

  @@map("nx01_calendar_event")
}

/// =======================================================
/// Nx01CarBrand — DB table `nx01_car_brand`
/// =======================================================
model Nx01CarBrand {
  /// [NX01]+[CABR]+[7碼流水號]，EX : NX01CABR0000001；啟用最低需求版本：LITE
  id                               String              @id @default(dbgenerated("gen_nx01_car_brand_id()")) @db.VarChar(15)
