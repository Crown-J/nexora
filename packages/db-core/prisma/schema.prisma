/// =======================================================
/// Nx01ImportBatch — DB table `nx01_import_batch`
/// v1.2 對齊軌 C：匯入精靈批次紀錄（§3.2）
/// =======================================================
model Nx01ImportBatch {
  /// [NX01]+[IMBA]+[7碼流水號]
  id            String    @id @default(dbgenerated("gen_nx01_import_batch_id()")) @db.VarChar(15)
  tenantId      String    @map("tenant_id") @db.VarChar(15)
  uploadedBy    String    @map("uploaded_by") @db.VarChar(15)
  /// 匯入類型：employee / partner / warehouse / product / purchase-history / sale-history / voucher
  importType    String    @map("import_type") @db.VarChar(30)
  fileName      String?   @map("file_name") @db.VarChar(255)
  totalRows     Int       @default(0) @map("total_rows")
  successRows   Int       @default(0) @map("success_rows")
  failedRows    Int       @default(0) @map("failed_rows")
  /// 失敗 row 詳細 JSON：[{ rowNo: 12, reason: 'Email 格式錯誤' }, ...]
  failureDetail Json?     @map("failure_detail")
  /// previewing / imported / cancelled
  status        String    @default("previewing") @db.VarChar(20)
  createdAt     DateTime  @default(now()) @map("created_at")
  importedAt    DateTime? @map("imported_at")

  tenant   Nx99Tenant @relation("R_Nx01ImportBatch_tenantId", fields: [tenantId], references: [id])
  uploader Nx01User   @relation("R_Nx01ImportBatch_uploadedBy", fields: [uploadedBy], references: [id])

  @@index([tenantId, importType])
  @@map("nx01_import_batch")
}

