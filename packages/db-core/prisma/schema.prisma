  /// 建立時間；啟用最低需求版本：LITE
  createdAt       DateTime        @default(now()) @map("created_at")
  /// 建立人；啟用最低需求版本：LITE
  createdBy       String          @map("created_by") @db.VarChar(15)
  /// 更新時間；啟用最低需求版本：LITE
  updatedAt       DateTime        @updatedAt @map("updated_at")
  /// 更新人；啟用最低需求版本：LITE
  updatedBy       String          @map("updated_by") @db.VarChar(15)
  tenant          Nx99Tenant      @relation("R_Nx98TaskPool_tenantId", fields: [tenantId], references: [id])
  department      Nx01Department? @relation("R_Nx98TaskPool_departmentId", fields: [departmentId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, assigneeUserId, status])
  @@index([tenantId, departmentId, status])
  @@index([tenantId, sourceModule, sourceDocId])
  @@map("nx98_task_pool")
}

/// =======================================================
/// Nx02RfqGreetingTemplate — DB table `nx02_rfq_greeting_template`（LITE 階段 1 新加）
/// 詢價文字客套話設定（每租戶 1:1、unique）：業務從料件+數量發起詢價、系統產生「開頭客套話 + 料件清單 + 結尾客套話」、業務複製到 LINE/電話問供應商。
/// =======================================================
model Nx02RfqGreetingTemplate {
  /// [NX02]+[RGTM]+[7碼流水號]，EX : NX02RGTM0000001；啟用最低需求版本：LITE
  id              String     @id @default(dbgenerated("gen_nx02_rfq_greeting_template_id()")) @db.VarChar(15)
  /// 租戶 ID（外鍵、unique 每租戶一套）；啟用最低需求版本：LITE
  tenantId        String     @map("tenant_id") @db.VarChar(15)
  /// 開頭客套話（例：「您好、想詢價以下零件：」）；啟用最低需求版本：LITE
  greetingContent String     @default("您好、想詢價以下零件：") @map("greeting_content") @db.VarChar(500)
  /// 結尾客套話（例：「麻煩報價謝謝」）；啟用最低需求版本：LITE
  closingContent  String     @default("麻煩報價謝謝") @map("closing_content") @db.VarChar(500)
  /// 是否啟用；啟用最低需求版本：LITE
  isActive        Boolean    @default(true) @map("is_active")
  /// 建立時間；啟用最低需求版本：LITE
  createdAt       DateTime   @default(now()) @map("created_at")
  /// 建立人；啟用最低需求版本：LITE
  createdBy       String     @map("created_by") @db.VarChar(15)
  /// 更新時間；啟用最低需求版本：LITE
  updatedAt       DateTime   @updatedAt @map("updated_at")
  /// 更新人；啟用最低需求版本：LITE
  updatedBy       String     @map("updated_by") @db.VarChar(15)
  tenant          Nx99Tenant @relation("R_Nx02RfqGreetingTemplate_tenantId", fields: [tenantId], references: [id])

  @@unique([tenantId])
  @@map("nx02_rfq_greeting_template")
}

/// =======================================================
/// PlatformAdmin — DB table `platform_admin`
/// 平台層 vs 租戶層分離軌 Phase 1（2026-06-02）
///
/// 性質：⚠️ 平台基礎設施、**非 spec 驅動**、手動維護（不在 docs/spec/ CSV 範圍）
/// 用途：伊諾瓦營運超管帳號、與客戶租戶 nx01_user 徹底分家、跨層不耦合
/// FK：created_by / updated_by 用 VARCHAR(15) scalar 不建 FK（跟 nx99_tenant 範式一致）
/// =======================================================
model PlatformAdmin {
  /// [PLAT]+[ADMN]+[7碼流水號]，EX : PLATADMN0000001
  id                 String    @id @default(dbgenerated("gen_platform_admin_id()")) @db.VarChar(15)
  /// 平台登入帳號（跨平台唯一、不分租戶）
  account            String    @unique @db.VarChar(50)
  /// 密碼雜湊
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  /// 顯示名稱
  displayName        String    @map("display_name") @db.VarChar(50)
  /// Email（選填）
  email              String?   @db.VarChar(100)
  /// 電話（選填）
  phone              String?   @db.VarChar(20)
  /// 是否啟用（停用後不可登入）
  isActive           Boolean   @default(true) @map("is_active")
  /// 首次登入強制改密碼
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  /// 最後登入時間
  lastLoginAt        DateTime? @map("last_login_at")
  /// 連續失敗登入次數
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  /// 帳號鎖定到何時
  lockedUntil        DateTime? @map("locked_until")
  /// 備註
  remark             String?   @db.VarChar(200)
  /// 建立時間
  createdAt          DateTime  @default(now()) @map("created_at")
  /// 建立人（VARCHAR scalar、無 FK、首筆 seed 自參考）
  createdBy          String    @map("created_by") @db.VarChar(15)
  /// 更新時間
  updatedAt          DateTime  @updatedAt @map("updated_at")
  /// 更新人（VARCHAR scalar、無 FK）
  updatedBy          String    @map("updated_by") @db.VarChar(15)

  @@map("platform_admin")
}

/// =======================================================
/// Nx01UserPref — DB table `nx01_user_pref`
/// 使用者層級個人偏好設定（2026-06-03 段 B 前置）
///
/// 性質：⚠️ 非 spec 驅動、手動維護（不在 docs/spec/ CSV 範圍）
/// 用途：user × pref_key、pref_value JSONB、彈性結構
///       首頁儀表板 5 格設定 / 未來主題 / 預設頁 / 提醒設定都走這張表
/// 範式：對齊 nx01_user_page_guide（同樣是 user × key 設計、是它兄弟）
/// =======================================================
model Nx01UserPref {
  /// [NX01]+[UPRF]+[7碼流水號]，EX : NX01UPRF0000001
  id        String     @id @default(dbgenerated("gen_nx01_user_pref_id()")) @db.VarChar(15)
  /// 租戶 ID（外鍵、查詢 scope）
  tenantId  String     @map("tenant_id") @db.VarChar(15)
  /// 使用者 ID（外鍵、設定擁有者）
  userId    String     @map("user_id") @db.VarChar(15)
  /// 偏好設定 key（例 'home.dashboard.metrics'、'theme'、'default-landing'）
  prefKey   String     @map("pref_key") @db.VarChar(100)
  /// 偏好設定值（JSONB、彈性結構）
  prefValue Json       @map("pref_value")
  /// 建立時間
  createdAt DateTime   @default(now()) @map("created_at")
  /// 建立人
  createdBy String     @map("created_by") @db.VarChar(15)
  /// 更新時間
  updatedAt DateTime   @updatedAt @map("updated_at")
  /// 更新人
  updatedBy String     @map("updated_by") @db.VarChar(15)
  tenant    Nx99Tenant @relation("R_Nx01UserPref_tenantId", fields: [tenantId], references: [id])
  user      Nx01User   @relation("R_Nx01UserPref_userId", fields: [userId], references: [id])

  @@unique([userId, prefKey])
  @@map("nx01_user_pref")
}

/// =======================================================
/// Nx01WarehouseZone — DB table `nx01_warehouse_zone`（2026-06-22 執行長拍板新增）
/// =======================================================
/// 倉庫內分區（A 區、B 區、不良品區…）。樹層級：site → warehouse → zone → location。
/// migration 階段為每倉預建一筆 code='Z00' name='主區'、現有 location.zoneId 全指該預設。
model Nx01WarehouseZone {
  /// [NX01]+[WHZN]+[7碼流水號]，EX : NX01WHZN0000001；啟用最低需求版本：LITE
  id          String          @id @default(dbgenerated("gen_nx01_warehouse_zone_id()")) @db.VarChar(15)
  /// 租戶 ID（外鍵）
  tenantId    String          @map("tenant_id") @db.VarChar(15)
  /// 所屬倉庫 ID（FK to nx01_warehouse、ON DELETE Restrict）
  warehouseId String          @map("warehouse_id") @db.VarChar(15)
  /// 分區代碼（倉內唯一）
  code        String          @db.VarChar(20)
  /// 分區名稱
  name        String          @db.VarChar(50)
  /// 排序用
  sortNo      Int             @default(0) @map("sort_no")
  /// 是否啟用（停用不刪資料）
  isActive    Boolean         @default(true) @map("is_active")
  /// 建立時間
  createdAt   DateTime        @default(now()) @map("created_at")
  /// 建立人
  createdBy   String          @map("created_by") @db.VarChar(15)
  /// 更新時間
  updatedAt   DateTime        @updatedAt @map("updated_at")
  /// 更新人
  updatedBy   String          @map("updated_by") @db.VarChar(15)
  tenant      Nx99Tenant      @relation("R_Nx01WarehouseZone_tenantId", fields: [tenantId], references: [id])
  warehouse   Nx01Warehouse   @relation("R_Nx01WarehouseZone_warehouseId", fields: [warehouseId], references: [id])
  rev_Nx01Location_zoneId Nx01Location[] @relation("R_Nx01Location_zoneId")

  @@unique([tenantId, warehouseId, code])
  @@index([tenantId, warehouseId], map: "nx01_warehouse_zone_tenant_warehouse_idx")
  @@map("nx01_warehouse_zone")
}
