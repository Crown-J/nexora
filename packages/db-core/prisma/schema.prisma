  /// 是否可匯出（CSV/Excel/PDF 等）；啟用最低需求版本：LITE
  canExport  Boolean    @default(false) @map("can_export")
  /// 是否啟用（停用不刪資料）；啟用最低需求版本：LITE
  isActive   Boolean    @default(true) @map("is_active")
  /// 授權時間；啟用最低需求版本：LITE
  grantedAt  DateTime   @default(now()) @map("granted_at")
  /// 授權人（對應使用者 ID）；啟用最低需求版本：LITE
  grantedBy  String?    @map("granted_by") @db.VarChar(15)
  /// 撤銷時間（撤銷才填）；啟用最低需求版本：LITE
  revokedAt  DateTime?  @map("revoked_at")
  /// 撤銷人（對應使用者 ID）；啟用最低需求版本：LITE
  revokedBy  String?    @map("revoked_by") @db.VarChar(15)
