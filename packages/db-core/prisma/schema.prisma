  sourceSoItem        Nx04SoItem    @relation("R_Nx04Co_sourceSoItemId", fields: [sourceSoItemId], references: [id])
  rev_Nx04SoItem_coId Nx04SoItem[]  @relation("R_Nx04SoItem_coId")

