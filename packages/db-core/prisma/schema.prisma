/// =======================================================
/// Nx03ConversionInput — DB table `nx03_conversion_input`
/// 轉換輸入明細（重組：N rows / 分解：1 row、application 層校驗 invariant）
/// =======================================================
model Nx03ConversionInput {
  /// [NX03]+[CVIN]+[7碼流水號]，EX : NX03CVIN0000001；啟用最低需求版本：LITE
  id            String           @id @default(dbgenerated("gen_nx03_conversion_input_id()")) @db.VarChar(15)
  /// 對應轉換單表頭 ID；啟用最低需求版本：LITE
  conversionId  String           @map("conversion_id") @db.VarChar(15)
  /// 明細行號（1,2,3…）；啟用最低需求版本：LITE
  lineNo        Int              @default(1) @map("line_no")
  /// 零件 ID；啟用最低需求版本：LITE
  partId        String           @map("part_id") @db.VarChar(15)
  /// 料號快照；啟用最低需求版本：LITE
  partNo        String           @map("part_no") @db.VarChar(50)
  /// 品名快照；啟用最低需求版本：LITE
  partName      String           @map("part_name") @db.VarChar(200)
  /// 過帳當下 part 版本快照 FK（M1 配套、Q-S1=B 既有 null、新 row 帶入）；啟用最低需求版本：LITE
  partVersionId String?          @map("part_version_id") @db.VarChar(15)
  /// 輸入庫位（從哪取料）；啟用最低需求版本：LITE
  locationId    String           @map("location_id") @db.VarChar(15)
  /// 輸入數量（>0、過帳時走 helper.applyQtyOutWithLedger source=M/D）；啟用最低需求版本：LITE
  qty           Decimal          @default(0) @db.Decimal(14, 4)
  /// 輸入單位成本（過帳時抓 stock_balance.avg_cost）；啟用最低需求版本：LITE
  unitCost      Decimal          @default(0) @map("unit_cost") @db.Decimal(14, 4)
  /// 輸入總成本（qty × unit_cost、重組時加總為 output unitCost 的加權基礎）；啟用最低需求版本：LITE
  totalCost     Decimal          @default(0) @map("total_cost") @db.Decimal(14, 2)
  /// 備註；啟用最低需求版本：LITE
  remark        String?          @db.VarChar(200)
  /// 建立時間；啟用最低需求版本：LITE
  createdAt     DateTime         @default(now()) @map("created_at")
  /// 建立人；啟用最低需求版本：LITE
  createdBy     String           @map("created_by") @db.VarChar(15)
  /// 更新時間；啟用最低需求版本：LITE
  updatedAt     DateTime         @updatedAt @map("updated_at")
  /// 更新人；啟用最低需求版本：LITE
  updatedBy     String           @map("updated_by") @db.VarChar(15)
  conversion    Nx03Conversion   @relation("R_Nx03ConversionInput_conversionId", fields: [conversionId], references: [id], onDelete: Cascade)
  part          Nx01Part         @relation("R_Nx03ConversionInput_partId", fields: [partId], references: [id])
  partVersion   Nx01PartVersion? @relation("R_Nx03ConversionInput_partVersionId", fields: [partVersionId], references: [id])
  location      Nx01Location     @relation("R_Nx03ConversionInput_locationId", fields: [locationId], references: [id])

  @@map("nx03_conversion_input")
}

/// =======================================================
/// Nx03ConversionOutput — DB table `nx03_conversion_output`
/// 轉換輸出明細（重組：1 row / 分解：N rows、application 層校驗 invariant）
/// 重組 output.unitCost = Σ (input.unitCost × input.qty)（Q-M4-1=a 加權、service 層算）
/// 分解 output.unitCost = input.totalCost × priceA_ratio（auto）或 costRatio（人工指定）
/// =======================================================
model Nx03ConversionOutput {
  /// [NX03]+[CVOT]+[7碼流水號]，EX : NX03CVOT0000001；啟用最低需求版本：LITE
  id            String           @id @default(dbgenerated("gen_nx03_conversion_output_id()")) @db.VarChar(15)
  /// 對應轉換單表頭 ID；啟用最低需求版本：LITE
  conversionId  String           @map("conversion_id") @db.VarChar(15)
  /// 明細行號（1,2,3…）；啟用最低需求版本：LITE
  lineNo        Int              @default(1) @map("line_no")
  /// 零件 ID；啟用最低需求版本：LITE
  partId        String           @map("part_id") @db.VarChar(15)
  /// 料號快照；啟用最低需求版本：LITE
  partNo        String           @map("part_no") @db.VarChar(50)
  /// 品名快照；啟用最低需求版本：LITE
  partName      String           @map("part_name") @db.VarChar(200)
  /// 過帳當下 part 版本快照 FK（M1 配套、Q-S1=B 既有 null、新 row 帶入）；啟用最低需求版本：LITE
  partVersionId String?          @map("part_version_id") @db.VarChar(15)
  /// 輸出庫位（入哪儲位）；啟用最低需求版本：LITE
  locationId    String           @map("location_id") @db.VarChar(15)
  /// 輸出數量（>0、過帳時走 helper.applyQtyInWithLedger source=M/D）；啟用最低需求版本：LITE
  qty           Decimal          @default(0) @db.Decimal(14, 4)
  /// 輸出單位成本（重組 = Σ 加權 input；分解 = input.totalCost × ratio、service 算）；啟用最低需求版本：LITE
  unitCost      Decimal          @default(0) @map("unit_cost") @db.Decimal(14, 4)
  /// 輸出總成本（qty × unit_cost）；啟用最低需求版本：LITE
  totalCost     Decimal          @default(0) @map("total_cost") @db.Decimal(14, 2)
  /// 成本分攤比例（分解時可選、0~1.0、null=auto 按 part.priceA 比例、非 null=人工指定）；啟用最低需求版本：LITE
  costRatio     Decimal?         @map("cost_ratio") @db.Decimal(8, 6)
  /// 備註；啟用最低需求版本：LITE
  remark        String?          @db.VarChar(200)
  /// 建立時間；啟用最低需求版本：LITE
  createdAt     DateTime         @default(now()) @map("created_at")
  /// 建立人；啟用最低需求版本：LITE
  createdBy     String           @map("created_by") @db.VarChar(15)
  /// 更新時間；啟用最低需求版本：LITE
  updatedAt     DateTime         @updatedAt @map("updated_at")
  /// 更新人；啟用最低需求版本：LITE
  updatedBy     String           @map("updated_by") @db.VarChar(15)
  conversion    Nx03Conversion   @relation("R_Nx03ConversionOutput_conversionId", fields: [conversionId], references: [id], onDelete: Cascade)
  part          Nx01Part         @relation("R_Nx03ConversionOutput_partId", fields: [partId], references: [id])
  partVersion   Nx01PartVersion? @relation("R_Nx03ConversionOutput_partVersionId", fields: [partVersionId], references: [id])
  location      Nx01Location     @relation("R_Nx03ConversionOutput_locationId", fields: [locationId], references: [id])

  @@map("nx03_conversion_output")
}

/// =======================================================
/// Nx03IssueReport — DB table `nx03_issue_report`
/// 異常回報跨模組共用表（NX03-STOCK-LITE M1、Crown 拍板 A=方案 A 獨立新表）
///
/// issueType（異常類型、5 類）：
///   D=Damaged 損毀 / E=Expired 過期 / S=Shortage 數量短缺 / L=WrongLocation 放錯庫位 / O=Other 其他
///
/// dispositionType（處置分流、5 出口）：
///   R=Return 退貨 → Nx02Rr / W=Warranty 保固 → Nx02WarrantyClaim /
///   C=Conversion 重組分解 → Nx03Conversion / D=Disposal 報廢 → Nx03Disposal /
///   N=None 未處置
///
/// 處置單據用 relatedDocId 軟連結（不建 FK、跨模組對齊 nx98 範式）。
/// 來源支援跨模組（sourceModule + sourceDocId 軟連結，例：銷貨檢貨發現異常 → 庫存統一入口）。
/// =======================================================
model Nx03IssueReport {
  /// [NX03]+[ISRP]+[7碼流水號]，EX : NX03ISRP0000001；啟用最低需求版本：LITE
  id              String           @id @default(dbgenerated("gen_nx03_issue_report_id()")) @db.VarChar(15)
  /// 租戶 ID（外鍵）；啟用最低需求版本：LITE
  tenantId        String           @map("tenant_id") @db.VarChar(15)
  /// 異常回報單號（唯一），[IR]+[年月]+[倉別]+[5碼流水號]，EX：IR-202605-Z01-00001；啟用最低需求版本：LITE
  docNo           String           @map("doc_no") @db.VarChar(30)
  /// 回報日期；啟用最低需求版本：LITE
  reportDate      DateTime         @map("report_date") @db.Date
  /// 異常發生倉庫（外鍵）；啟用最低需求版本：LITE
  warehouseId     String           @map("warehouse_id") @db.VarChar(15)
  /// 異常具體庫位（外鍵、issueType=L 放錯庫位時必填、其他選填）；啟用最低需求版本：LITE
  locationId      String?          @map("location_id") @db.VarChar(15)
  /// 異常零件 ID（外鍵）；啟用最低需求版本：LITE
  partId          String           @map("part_id") @db.VarChar(15)
  /// 料號快照；啟用最低需求版本：LITE
  partNo          String           @map("part_no") @db.VarChar(50)
  /// 品名快照；啟用最低需求版本：LITE
  partName        String           @map("part_name") @db.VarChar(200)
  /// part 版本快照 FK（對齊 NX01-17 範式、既有 null、新 row 帶入）；啟用最低需求版本：LITE
  partVersionId   String?          @map("part_version_id") @db.VarChar(15)
  /// 異常數量（≥0、不影響庫存帳、純記錄）；啟用最低需求版本：LITE
  qty             Decimal          @default(0) @db.Decimal(14, 4)
  /// 異常類型（D=損毀 / E=過期 / S=數量短缺 / L=放錯庫位 / O=其他）；啟用最低需求版本：LITE
  issueType       String           @map("issue_type") @db.VarChar(1)
  /// 處置方式（R=退貨 / W=保固 / C=重組分解 / D=報廢 / N=未處置；預設 N）；啟用最低需求版本：LITE
  dispositionType String           @default("N") @map("disposition_type") @db.VarChar(1)
  /// 關聯處置單據 ID（軟連結、不建 FK、視 dispositionType 對應 Nx02Rr/Nx02WarrantyClaim/Nx03Conversion/Nx03Disposal）；啟用最低需求版本：LITE
  relatedDocId    String?          @map("related_doc_id") @db.VarChar(15)
  /// 來源模組（跨模組共用入口、軟連結，例：nx03 / nx04 / nx06）；啟用最低需求版本：LITE
  sourceModule    String?          @map("source_module") @db.VarChar(10)
  /// 來源單據類型（例：stock-take / so / sr / dn）；啟用最低需求版本：LITE
  sourceDocType   String?          @map("source_doc_type") @db.VarChar(20)
  /// 來源單據 ID（軟連結、不建 FK）；啟用最低需求版本：LITE
  sourceDocId     String?          @map("source_doc_id") @db.VarChar(15)
  /// 狀態（DRAFT=草稿 / REPORTED=已回報 / PROCESSING=處置中 / CLOSED=已結案 / CANCELLED=作廢）；啟用最低需求版本：LITE
  status          String           @default("DRAFT") @db.VarChar(30)
  /// 異常說明（issueType=O 其他時建議必填）；啟用最低需求版本：LITE
  description     String?          @db.VarChar(500)
  /// 附件 URL 或 base64（M3 UI 拍照功能、對齊保固附件範式、單檔 LITE 不嚴限制）；啟用最低需求版本：LITE
  photoUrl        String?          @map("photo_url") @db.VarChar(500)
  /// 結案時間（status=CLOSED 才有）；啟用最低需求版本：LITE
  closedAt        DateTime?        @map("closed_at")
  /// 結案人（status=CLOSED 才有）；啟用最低需求版本：LITE
  closedBy        String?          @map("closed_by") @db.VarChar(15)
  /// 建立時間；啟用最低需求版本：LITE
  createdAt       DateTime         @default(now()) @map("created_at")
  /// 建立人；啟用最低需求版本：LITE
  createdBy       String           @map("created_by") @db.VarChar(15)
  /// 更新時間；啟用最低需求版本：LITE
  updatedAt       DateTime         @updatedAt @map("updated_at")
  /// 更新人；啟用最低需求版本：LITE
  updatedBy       String           @map("updated_by") @db.VarChar(15)
  tenant          Nx99Tenant       @relation("R_Nx03IssueReport_tenantId", fields: [tenantId], references: [id])
  warehouse       Nx01Warehouse    @relation("R_Nx03IssueReport_warehouseId", fields: [warehouseId], references: [id])
  location        Nx01Location?    @relation("R_Nx03IssueReport_locationId", fields: [locationId], references: [id])
  part            Nx01Part         @relation("R_Nx03IssueReport_partId", fields: [partId], references: [id])
  partVersion     Nx01PartVersion? @relation("R_Nx03IssueReport_partVersionId", fields: [partVersionId], references: [id])

  @@unique([docNo])
  @@map("nx03_issue_report")
}

/// =======================================================
/// Nx03BrandAllocationRule — DB table `nx03_brand_allocation_rule`
/// AR 自動補貨配比規則（AR-IMPL-01 M2、Crown Q-AR-設計-1=a 新建主檔）
/// modelId 級配比（Crown Q-B1=A）：同 model 一條配比規則、適用該 model 下所有 parts
/// source 雙來源（Crown Q-S1=A manual 覆寫 system）：S=system 自動 / M=manual 手動
/// 支援歷史版本：unique [tenantId, modelId, validFrom]、validTo 可空（現役留空）
/// =======================================================
model Nx03BrandAllocationRule {
  /// [NX03]+[BALR]+[7碼流水號]，EX : NX03BALR0000001；啟用最低需求版本：PLUS
  id               String     @id @default(dbgenerated("gen_nx03_brand_allocation_rule_id()")) @db.VarChar(15)
  /// 租戶 ID（外鍵）；啟用最低需求版本：PLUS
  tenantId         String     @map("tenant_id") @db.VarChar(15)
  /// 車型 FK（必填、配比規則 modelId 級 Crown Q-B1=A）；啟用最低需求版本：PLUS
  modelId          String     @map("model_id") @db.VarChar(15)
  /// OE 正廠採購比例（0.0000~1.0000、與 aftermarketRatio 兩者 Σ 應 = 1.0、application 自律校驗）；啟用最低需求版本：PLUS
  oemRatio         Decimal    @default(0.5) @map("oem_ratio") @db.Decimal(5, 4)
  /// 副廠採購比例（0.0000~1.0000）；啟用最低需求版本：PLUS
  aftermarketRatio Decimal    @default(0.5) @map("aftermarket_ratio") @db.Decimal(5, 4)
  /// 配比來源（S=system 自動算 / M=manual 手動覆寫、Q-S1=A manual 覆寫 system）；啟用最低需求版本：PLUS
  source           String     @default("S") @db.VarChar(1)
  /// 生效起期（必填）；啟用最低需求版本：PLUS
  validFrom        DateTime   @map("valid_from") @db.Date
  /// 生效迄期（null=現役、application 層校驗 validFrom ≤ validTo）；啟用最低需求版本：PLUS
  validTo          DateTime?  @map("valid_to") @db.Date
  /// 是否啟用；啟用最低需求版本：PLUS
  isActive         Boolean    @default(true) @map("is_active")
  /// 備註；啟用最低需求版本：PLUS
  remark           String?    @db.VarChar(200)
  /// 建立時間；啟用最低需求版本：PLUS
  createdAt        DateTime   @default(now()) @map("created_at")
  /// 建立人；啟用最低需求版本：PLUS
  createdBy        String     @map("created_by") @db.VarChar(15)
  /// 更新時間；啟用最低需求版本：PLUS
  updatedAt        DateTime   @updatedAt @map("updated_at")
  /// 更新人；啟用最低需求版本：PLUS
  updatedBy        String     @map("updated_by") @db.VarChar(15)
  tenant           Nx99Tenant @relation("R_Nx03BrandAllocationRule_tenantId", fields: [tenantId], references: [id])
  model            Nx01Model  @relation("R_Nx03BrandAllocationRule_modelId", fields: [modelId], references: [id])

  @@unique([tenantId, modelId, validFrom])
  @@index([tenantId, modelId])
  @@map("nx03_brand_allocation_rule")
}

/// =======================================================
