  sourcePrItemId                          String?                       @map("source_pr_item_id") @db.VarChar(15)
  /// 備註；啟用最低需求版本：LITE
  remark                                  String?                       @db.VarChar(500)
  /// 建立時間。；啟用最低需求版本：LITE
  createdAt                               DateTime                      @default(now()) @map("created_at")
  /// 建立人（必填；系統操作帶入使用者 ID）；啟用最低需求版本：LITE
  createdBy                               String                        @map("created_by") @db.VarChar(15)
  /// 更新時間。；啟用最低需求版本：LITE
  updatedAt                               DateTime                      @updatedAt @map("updated_at")
  /// 更新人（必填；系統操作帶入使用者 ID）；啟用最低需求版本：LITE
  updatedBy                               String                        @map("updated_by") @db.VarChar(15)
  /// 作廢時間（status=V 才有）；啟用最低需求版本：LITE
  voidedAt                                DateTime?                     @map("voided_at")
  /// 作廢人（使用者 ID）；啟用最低需求版本：LITE
  voidedBy                                String?                       @map("voided_by") @db.VarChar(15)
  tenant                                  Nx99Tenant                    @relation("R_Nx02WarrantyClaim_tenantId", fields: [tenantId], references: [id])
  supplier                                Nx01Partner                   @relation("R_Nx02WarrantyClaim_supplierId", fields: [supplierId], references: [id])
  part                                    Nx01Part                      @relation("R_Nx02WarrantyClaim_partId", fields: [partId], references: [id])
  rev_Nx02WarrantyClaimAttachment_claimId Nx02WarrantyClaimAttachment[] @relation("R_Nx02WarrantyClaimAttachment_claimId")

  @@unique([docNo])
  @@index([tenantId, supplierId])
  @@index([tenantId, partId])
  @@index([tenantId, status])
  @@map("nx02_warranty_claim")
}

