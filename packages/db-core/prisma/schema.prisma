/// =======================================================
/// Nx01PartKit — DB table `nx01_part_kit`（組合/拆解組件關係表頭，2026-06-26 新增）
/// =======================================================
/// 業務範式：一個「整體件」等同於一組「組件（含數量）」。
///   - 種類 3 拆解：整體＝正廠總成、組件＝副廠拆出的多個零件（A ＝ B×1 + C×2 + D×1）
///   - 種類 4 組合：整體＝副廠合成件、組件＝多個正廠分售件（X + Y ＝ Z）
model Nx01PartKit {
  /// [NX01]+[PKIT]+[7碼流水號]，EX : NX01PKIT0000001；啟用最低需求版本：LITE
  id          String            @id @default(dbgenerated("gen_nx01_part_kit_id()")) @db.VarChar(15)
  /// 租戶 ID（外鍵）；啟用最低需求版本：LITE
  tenantId    String            @map("tenant_id") @db.VarChar(15)
  /// 整體件 FK（被替代的單一料號：種類3=正廠總成 / 種類4=副廠合成件）；啟用最低需求版本：LITE
  wholePartId String            @map("whole_part_id") @db.VarChar(15)
  /// 關係名稱（顯示用、例：1K0407621 副廠拆解組）；啟用最低需求版本：LITE
  name        String            @db.VarChar(100)
  /// 備註；啟用最低需求版本：LITE
  remark      String?           @db.VarChar(200)
  /// 排序；啟用最低需求版本：LITE
  sortNo      Int               @default(0) @map("sort_no")
  /// 是否啟用；啟用最低需求版本：LITE
  isActive    Boolean           @default(true) @map("is_active")
  createdAt   DateTime          @default(now()) @map("created_at")
  createdBy   String            @map("created_by") @db.VarChar(15)
  updatedAt   DateTime          @updatedAt @map("updated_at")
  updatedBy   String            @map("updated_by") @db.VarChar(15)
  tenant      Nx99Tenant        @relation("R_Nx01PartKit_tenantId", fields: [tenantId], references: [id])
  wholePart   Nx01Part          @relation("R_Nx01PartKit_wholePartId", fields: [wholePartId], references: [id])
  items       Nx01PartKitItem[] @relation("R_Nx01PartKitItem_kitId")

  @@index([tenantId, wholePartId])
  @@map("nx01_part_kit")
}

/// =======================================================
/// Nx01PartKitItem — DB table `nx01_part_kit_item`（組合/拆解組件明細，2026-06-26 新增）
