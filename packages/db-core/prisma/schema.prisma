  /// 單據狀態（D=草稿 / P=已過帳 / V=作廢）；啟用最低需求版本：LITE
  status                String         @default("D") @db.VarChar(1)
  /// 小計（明細加總，未稅）；啟用最低需求版本：LITE
  subtotal              Decimal        @default(0) @db.Decimal(14, 2)
  /// 稅率（預設 5.00）；啟用最低需求版本：LITE
  taxRate               Decimal        @default(5) @map("tax_rate") @db.Decimal(5, 2)
  /// 稅額（可手動覆寫）；啟用最低需求版本：LITE
  taxAmount             Decimal        @default(0) @map("tax_amount") @db.Decimal(14, 2)
  /// 總額（subtotal + tax_amount）；啟用最低需求版本：LITE
  totalAmount           Decimal        @default(0) @map("total_amount") @db.Decimal(14, 2)
  /// 備註；啟用最低需求版本：LITE
  remark                String?        @db.VarChar(200)
  /// 建立時間。；啟用最低需求版本：LITE
  createdAt             DateTime       @default(now()) @map("created_at")
  /// 建立人（必填；系統操作帶入使用者 ID；DB 匯入填系統管理員 ID）；啟用最低需求版本：LITE
  createdBy             String         @map("created_by") @db.VarChar(15)
  /// 更新時間。；啟用最低需求版本：LITE
  updatedAt             DateTime       @updatedAt @map("updated_at")
  /// 更新人（必填；系統操作帶入使用者 ID；DB 匯入填系統管理員 ID）；啟用最低需求版本：LITE
  updatedBy             String         @map("updated_by") @db.VarChar(15)
  /// 過帳時間（POSTED 才有）；啟用最低需求版本：LITE
  postedAt              DateTime?      @map("posted_at")
  /// 過帳人（POSTED 才有）；啟用最低需求版本：LITE
  postedBy              String?        @map("posted_by") @db.VarChar(15)
  /// 作廢時間；啟用最低需求版本：LITE
  voidedAt              DateTime?      @map("voided_at")
  /// 作廢人（使用者 ID）；啟用最低需求版本：LITE
  voidedBy              String?        @map("voided_by") @db.VarChar(15)
  /// 採購組長核准時間。；啟用最低需求版本：LITE-CORE
  approvedAt            DateTime?      @map("approved_at")
  /// 採購組長核准人（使用者ID）。；啟用最低需求版本：LITE-CORE
  approvedBy            String?        @map("approved_by") @db.VarChar(15)
  /// 退件原因（採購組長退件時填寫）。；啟用最低需求版本：LITE-CORE
  rejectReason          String?        @map("reject_reason") @db.VarChar(200)
  /// 付款狀態（U=未付款/P=已付款）。決定退貨後帳務處理方式：未付款沖銷AP；已付款產生應收廠商退款。；啟用最低需求版本：LITE-CORE
  paymentStatus         String         @default("U") @map("payment_status") @db.VarChar(1)
  /// 退貨類型（F=全部退/P=部分退預設/A=折讓不退）。F/P 走既有 ledger 沖庫存 source=R；A 走 Nx05Allowance（allowanceType=P 進貨折讓）不沖庫存。NX02-IMPL-01 Phase 1 M3 補齊（Crown Q19=d 多種並存、Q-S2=A default 'P' 業界常態）。；啟用最低需求版本：LITE-CORE
  returnMode            String         @default("P") @map("return_mode") @db.VarChar(1)
  /// 階段 I P1 加：退貨處置標記（G=一般退 / B=壞品退 / W=走保固）。Alex Q1=a 拍板。W 觸發 service 層自動建 Nx02WarrantyClaim 進保固理賠流程；G/B 走既有 ledger。default 'G' = 既有 row backfill 為一般退、不破壞歷史語意。
  dispositionFlag       String         @default("G") @map("disposition_flag") @db.VarChar(1)
  tenant                Nx99Tenant     @relation("R_Nx02Pr_tenantId", fields: [tenantId], references: [id])
  warehouse             Nx01Warehouse  @relation("R_Nx02Pr_warehouseId", fields: [warehouseId], references: [id])
  supplier              Nx01Partner    @relation("R_Nx02Pr_supplierId", fields: [supplierId], references: [id])
  rr                    Nx02Rr?        @relation("R_Nx02Pr_rrId", fields: [rrId], references: [id])
  rev_Nx02PrItem_prId   Nx02PrItem[]   @relation("R_Nx02PrItem_prId")
  /// 階段 F P1 加：廠商退費衍生應收（PR POSTED → AR、Q1=a-1 對齊 ApLedger 多來源範式）
  rev_Nx05ArLedger_prId Nx05ArLedger[] @relation("R_Nx05ArLedger_prId")

  @@unique([docNo])
  @@map("nx02_pr")
}

