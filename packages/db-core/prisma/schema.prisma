/// =======================================================
/// Nx01SeqCounter — DB table `nx01_seq_counter`（W3 [3-1] 2026-06-06 租戶內編號流水）
/// 用途：
///   - 員工編號 Y0001 ~ Y9999（scope='EMPLOYEE'）— Crown 拍板 employeeNo = userAccount
///   - 往來對象編號類型碼 + 4 碼（scope='PARTNER_C' / PARTNER_O / PARTNER_S / PARTNER_V / PARTNER_T / PARTNER_B / PARTNER_L）
/// 取號方式：service 層原子取號（UPDATE ... SET next_no = next_no + 1）
/// 手動覆寫：caller 傳 code 時直接寫入；若手動值 ≥ next_no 自動跳號（防衝突）
/// 對齊 NX-MANUAL-02 v2.0 §3.1 員工編號 + §3.5/§3.6 往來對象六分類 + 散客 L。
/// =======================================================
model Nx01SeqCounter {
  /// [NX01]+[SQCT]+[7碼流水號]，EX : NX01SQCT0000001
  id        String     @id @default(dbgenerated("gen_nx01_seq_counter_id()")) @db.VarChar(15)
  /// 租戶 ID
  tenantId  String     @map("tenant_id") @db.VarChar(15)
  /// 流水範圍 enum：EMPLOYEE / PARTNER_C / PARTNER_O / PARTNER_S / PARTNER_V / PARTNER_T / PARTNER_B / PARTNER_L
  scope     String     @db.VarChar(20)
  /// 下一個自動編號流水值（每次取號後 +1）
  nextNo    Int        @default(1) @map("next_no")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  tenant    Nx99Tenant @relation("R_Nx01SeqCounter_tenantId", fields: [tenantId], references: [id])

  @@unique([tenantId, scope])
  @@map("nx01_seq_counter")
}

/// =======================================================
/// Nx01UserRole — DB table `nx01_user_role`
/// =======================================================
model Nx01UserRole {
  /// [NX01]+[USRO]+[7碼流水號]，EX : NX01USRO0000001；啟用最低需求版本：LITE
  id         String     @id @default(dbgenerated("gen_nx01_user_role_id()")) @db.VarChar(15)
  /// 租戶 ID（外鍵）；啟用最低需求版本：LITE
  tenantId   String     @map("tenant_id") @db.VarChar(15)
  /// 使用者 ID（外鍵）。；啟用最低需求版本：LITE
  userId     String     @map("user_id") @db.VarChar(15)
  /// 角色 ID（外鍵）。；啟用最低需求版本：LITE
  roleId     String     @map("role_id") @db.VarChar(15)
  /// 是否主要角色（用於預設權限/預設首頁顯示等）；啟用最低需求版本：LITE
  isPrimary  Boolean    @default(false) @map("is_primary")
  /// 指派時間；啟用最低需求版本：LITE
  assignedAt DateTime   @default(now()) @map("assigned_at")
  /// 指派者（使用者 ID）；啟用最低需求版本：LITE
  assignedBy String?    @map("assigned_by") @db.VarChar(15)
  /// 取消指派時間（保留歷史用；若你想硬刪也可不需要）；啟用最低需求版本：LITE
  revokedAt  DateTime?  @map("revoked_at")
  /// 是否有效（TRUE=目前生效；FALSE=已取消但保留紀錄）；啟用最低需求版本：LITE
  isActive   Boolean    @default(true) @map("is_active")
  tenant     Nx99Tenant @relation("R_Nx01UserRole_tenantId", fields: [tenantId], references: [id])
  user       Nx01User   @relation("R_Nx01UserRole_userId", fields: [userId], references: [id])
  role       Nx01Role   @relation("R_Nx01UserRole_roleId", fields: [roleId], references: [id])

  @@unique([tenantId, userId, roleId])
  @@map("nx01_user_role")
}

/// =======================================================
/// Nx01UserPageGuide — DB table `nx01_user_page_guide`
/// v1.2 對齊軌 C：每位員工 × 每頁面的設定精靈記憶（§3.3）
