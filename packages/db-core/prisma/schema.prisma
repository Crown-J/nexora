/// =======================================================
/// Nx01PartOemCode — DB table `nx01_part_oem_code`（零件 ↔ 正廠對應料號，下半場 B）
/// 一筆零件可對應多筆正廠料號（給業務員核對替代品；零件搜尋同時 match）。
/// =======================================================
model Nx01PartOemCode {
  /// [NX01]+[POEM]+[7碼流水號]；啟用最低需求版本：LITE
  id          String     @id @default(dbgenerated("gen_nx01_part_oem_code_id()")) @db.VarChar(15)
  /// 租戶 ID；啟用最低需求版本：LITE
  tenantId    String     @map("tenant_id") @db.VarChar(15)
  /// 所屬零件 ID（FK nx01_part，刪零件連帶刪）；啟用最低需求版本：LITE
  partId      String     @map("part_id") @db.VarChar(15)
  /// 對應品牌 ID（FK nx01_brand）；啟用最低需求版本：LITE
  /// W6 [3-8] Phase 5 2026-06-06 品牌合併：取代舊 partBrandId
  brandId     String?    @map("brand_id") @db.VarChar(15)
  /// 正廠料號（文字）；啟用最低需求版本：LITE
  oemCode     String     @map("oem_code") @db.VarChar(50)
  /// 備註（如「Golf 7 用」「3 系列用」）；啟用最低需求版本：LITE
  remark      String?    @db.VarChar(200)
  /// 排序；啟用最低需求版本：LITE
  sortNo      Int        @default(0) @map("sort_no")
  createdAt   DateTime   @default(now()) @map("created_at")
  createdBy   String     @map("created_by") @db.VarChar(15)
  updatedAt   DateTime   @updatedAt @map("updated_at")
  updatedBy   String     @map("updated_by") @db.VarChar(15)
  part        Nx01Part   @relation("R_Nx01PartOemCode_partId", fields: [partId], references: [id], onDelete: Cascade)
  /// W6 [3-8] 2026-06-06 品牌合併
  brand       Nx01Brand? @relation("R_Nx01PartOemCode_brandId", fields: [brandId], references: [id], onDelete: SetNull)

  @@index([tenantId, oemCode])
  @@index([partId])
  @@map("nx01_part_oem_code")
}

