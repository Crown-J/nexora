/// =======================================================
/// Nx01City — DB table `nx01_city`（NX01-09 地址型錄系統 v1.0）
/// =======================================================
model Nx01City {
  /// [NX01]+[CITY]+[7碼流水號]，EX : NX01CITY0000001；啟用最低需求版本：LITE
  id        String   @id @default(dbgenerated("gen_nx01_city_id()")) @db.VarChar(15)
  /// 縣市代碼（如 TPE / NWT / KAO、ISO 3166-2:TW）；啟用最低需求版本：LITE
  code      String   @db.VarChar(3)
  /// 中文名（如 臺北市）；啟用最低需求版本：LITE
  name      String   @db.VarChar(20)
  /// 英文名（如 Taipei City）；啟用最低需求版本：LITE
  nameEn    String?  @map("name_en") @db.VarChar(50)
  /// 國家 ID（FK to nx01_country、預設 TWN 台灣、Q4 國外擴展性預留）；啟用最低需求版本：LITE
  countryId String   @map("country_id") @db.VarChar(15)
  /// 排序順位（業界慣例如六都優先）；啟用最低需求版本：LITE
  sortOrder Int      @default(0) @map("sort_order")
  /// 是否啟用；啟用最低需求版本：LITE
  isActive  Boolean  @default(true) @map("is_active")
  /// 建立時間；啟用最低需求版本：LITE
  createdAt DateTime @default(now()) @map("created_at")
  /// 建立人（必填；系統操作帶入使用者 ID；DB 匯入填系統管理員 ID）；啟用最低需求版本：LITE
  createdBy String   @map("created_by") @db.VarChar(15)
  /// 更新時間；啟用最低需求版本：LITE
  updatedAt DateTime @updatedAt @map("updated_at")
  /// 更新人（必填；系統操作帶入使用者 ID；DB 匯入填系統管理員 ID）；啟用最低需求版本：LITE
  updatedBy String   @map("updated_by") @db.VarChar(15)

  country                               Nx01Country                  @relation("R_Nx01City_countryId", fields: [countryId], references: [id])
  rev_Nx01District_cityId               Nx01District[]               @relation("R_Nx01District_cityId")
  rev_Nx01PartnerAddress_cityId         Nx01PartnerAddress[]         @relation("R_Nx01PartnerAddress_cityId")
  rev_Nx01User_householdCityId          Nx01User[]                   @relation("R_Nx01User_householdCityId")
  rev_Nx01User_mailingCityId            Nx01User[]                   @relation("R_Nx01User_mailingCityId")
  rev_Nx01Warehouse_cityId              Nx01Warehouse[]              @relation("R_Nx01Warehouse_cityId")

  @@unique([countryId, code])
  @@map("nx01_city")
}

