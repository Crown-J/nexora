/// =======================================================
/// Nx01Partner — DB table `nx01_partner`
/// =======================================================
model Nx01Partner {
  /// [NX01]+[PTNR]+[7碼流水號]，EX : NX01PTNR0000001；啟用最低需求版本：LITE
  id                                       String                       @id @default(dbgenerated("gen_nx01_partner_id()")) @db.VarChar(15)
  /// 租戶 ID（外鍵）；啟用最低需求版本：LITE
  tenantId                                 String                       @map("tenant_id") @db.VarChar(15)
  /// 交易對象代碼（唯一），例：C0001、S0003、BP0008；啟用最低需求版本：LITE
  code                                     String                       @db.VarChar(30)
  /// 交易對象名稱（公司名/店名/個人名）；啟用最低需求版本：LITE
  name                                     String                       @db.VarChar(120)
  /// 角色類型六分類：C=保養廠（純買方、ABCD 定價、應收）/ O=同行（雙向買+調貨、ABCD 定價、應收+應付軋帳、預設 canTransferStock=true）/ S=供應商（純賣方正規來源、採購比價/補貨對象、應付）/ T=外包物流 / B=銀行 / V=一般廠商。Application 層 enum、不在 DB 強制（Crown Q-PP-2=a）；啟用最低需求版本：LITE
  partnerType                              String                       @default("C") @map("partner_type") @db.VarChar(1)
  /// 可調貨旗標。partner_type=O 同行業務上預設 true（service 層 create 時帶入）；partner_type=C 保養廠預設 false、少數保養廠偶爾調貨時可手動開啟。調貨對象篩選 = WHERE partner_type='O' OR canTransferStock=true。對齊 can_* 範式；啟用最低需求版本：LITE
  canTransferStock                         Boolean                      @default(false) @map("can_transfer_stock")
  /// 聯絡人（可空、主要單一聯絡人；多窗口走 nx01_partner_contact 子表）；啟用最低需求版本：LITE
  contactName                              String?                      @map("contact_name") @db.VarChar(50)
  /// 對方公司負責人姓名（與本公司業務歸屬 sales_user_id 不同）；02 第三批 T2 2026-06-07 新增、啟用最低需求版本：LITE
  ownerName                                String?                      @map("owner_name") @db.VarChar(50)
  /// 電話（可空）；啟用最低需求版本：LITE
  phone                                    String?                      @db.VarChar(30)
  /// 手機（可空）；啟用最低需求版本：LITE
  mobile                                   String?                      @db.VarChar(30)
  /// Email（可空）；啟用最低需求版本：LITE
  email                                    String?                      @db.VarChar(100)
  /// 國別 FK（null 視為 TW 預設）；02 對齊第二批 A 軌 CP2 2026-06-06 新增
  countryId                                String?                      @map("country_id") @db.VarChar(15)
  /// 備註（例：習慣月結、送貨時間、黑名單原因等）；啟用最低需求版本：LITE
  remark                                   String?                      @db.VarChar(200)
  /// 是否啟用（停用後不可再開單）；啟用最低需求版本：LITE
  isActive                                 Boolean                      @default(true) @map("is_active")
  /// 建立時間。；啟用最低需求版本：LITE
  createdAt                                DateTime                     @default(now()) @map("created_at")
  /// 建立人（必填；系統操作帶入使用者 ID；DB 匯入填系統管理員 ID）；啟用最低需求版本：LITE
  createdBy                                String                       @map("created_by") @db.VarChar(15)
  /// 更新時間。；啟用最低需求版本：LITE
  updatedAt                                DateTime                     @updatedAt @map("updated_at")
  /// 更新人（必填；系統操作帶入使用者 ID；DB 匯入填系統管理員 ID）；啟用最低需求版本：LITE
  updatedBy                                String                       @map("updated_by") @db.VarChar(15)
  /// 舊系統往來對象代號（純對照、不綁 FK、對齊零件 oldCode 範式）；W3 [3-2] 2026-06-06 新增
  legacyCode                               String?                      @map("legacy_code") @db.VarChar(50)
  /// 預設發票聯式（2=二聯 / 3=三聯）。SO 建單自動帶入、可逐筆改。散客 L 強制 2、不可改。；W4 [3-6] 2026-06-06 新增
  defaultInvoiceCopies                     Int                          @default(3) @map("default_invoice_copies") @db.SmallInt
  /// 地區 ID（FK nx01_region、顯示用、不入 partner code 編號）；02 對齊第二批 C 軌 CP1 2026-06-06 新增
  regionId                                 String?                      @map("region_id") @db.VarChar(15)
  /// 總公司 ID（self-FK、連鎖母子關係、null=自己就是總公司或無總公司）；02 對齊第二批 C 軌 CP1 2026-06-06 新增
  parentPartnerId                          String?                      @map("parent_partner_id") @db.VarChar(15)
  /// 個別客戶毛利率覆寫（覆寫 customer_grade.margin_pct、業務口語「個別折數」）；02 對齊第二批 C 軌 CP1 2026-06-06 新增
  customMarginPct                          Decimal?                     @map("custom_margin_pct") @db.Decimal(5, 2)
  /// 統一編號（開立發票用，客戶與廠商均可填寫，選填）。；啟用最低需求版本：LITE-CORE
  taxId                                    String?                      @map("tax_id") @db.VarChar(20)
  /// 國內付款條件（PREPAY=先付款/NET30=月結30天/NET60=月結60天/NET90=月結90天）。影響國內採購AP/AR到期日計算。建立採購單時自動帶入，可手動覆蓋。；啟用最低需求版本：LITE-CORE
  paymentTermDomestic                      String                       @default("NET30") @map("payment_term_domestic") @db.VarChar(10)
  /// 客戶等級ID（FK nx01_customer_grade），供報價單定價邏輯使用。partner_type IN ('C', 'O') 通用（保養廠+同行都走 ABCD 定價、業界 muscle memory：同行看交情/量、保養廠看消費力）。；啟用最低需求版本：LITE-CORE
  customerGradeId                          String?                      @map("customer_grade_id") @db.VarChar(15)
  /// 供應商等級ID（FK nx01_supplier_grade），採購視角、partner_type='S' 純供應商用。LITE 階段 1 手動指派為主（初期數據累積後再補自動算：付款條件→信用紀錄→不良率）。；啟用最低需求版本：LITE-CORE
  supplierGradeId                          String?                      @map("supplier_grade_id") @db.VarChar(15)
  /// 信用額度（客戶用），0=不限制。已用額度超過80%警示，超過100%通知負責人。負責人可設定口頭警告/僅收現金/凍結三種處置方式。；啟用最低需求版本：LITE-CORE
  creditLimit                              Decimal?                     @default(0) @map("credit_limit") @db.Decimal(15, 2)
  /// 信用狀態（N=正常/W=僅收現金/F=凍結）。凍結時業務無法建立新SO，系統直接擋單。由負責人設定。；啟用最低需求版本：LITE-CORE
  creditStatus                             String                       @default("N") @map("credit_status") @db.VarChar(1)
  /// 進口付款條件預設值（TT=電匯T/T/LC=信用狀L/C/DP=付款交單D/P/DA=承兌交單D/A）。建立進口採購單時自動帶入，可手動覆蓋。；啟用最低需求版本：LITE-CORE
  paymentTermImport                        String?                      @default("TT") @map("payment_term_import") @db.VarChar(5)
  /// 貿易條件預設值（FOB/CIF/EXW/DDP等），建立進口採購單時自動帶入作為預設，可於採購單層級手動覆蓋。影響進口費用攤分的必填欄位判斷。；啟用最低需求版本：LITE-CORE
  incoterm                                 String?                      @default("FOB") @db.VarChar(5)
  /// 公司簡稱（精簡顯示用、注音索引欄位之一）；啟用最低需求版本：LITE
  shortName                                String?                      @map("short_name") @db.VarChar(50)
  /// 公司英文名（國際 / 進口場景顯示）；啟用最低需求版本：LITE
  nameEn                                   String?                      @map("name_en") @db.VarChar(100)
  /// 傳真號（業界仍有使用、補對齊既有 mobile）；啟用最低需求版本：LITE
  fax                                      String?                      @db.VarChar(30)
  /// 公司官網 URL；啟用最低需求版本：LITE
  website                                  String?                      @db.VarChar(200)
  /// 負責據點（業務分區 / 區域代碼）；啟用最低需求版本：LITE
  serviceLocation                          String?                      @map("service_location") @db.VarChar(50)
  /// 業務歸屬使用者 ID（FK nx01_user、業務離職時 SET NULL、5 種 partner_type 通用）；啟用最低需求版本：LITE
  salesUserId                              String?                      @map("sales_user_id") @db.VarChar(15)
  /// 預設交易幣別 ID（FK nx01_currency、ON DELETE RESTRICT 幣別不可刪）；啟用最低需求版本：LITE
  defaultCurrencyId                        String?                      @map("default_currency_id") @db.VarChar(15)
  /// 客戶預設取貨據點（FK nx01_warehouse、ON DELETE SET NULL、業界 muscle memory：客戶習慣取貨倉、SO 建單自動帶入、無庫存自動 NX03 ST 調撥）。NX04-IMPL-01 Phase 1 M1 新增。；啟用最低需求版本：LITE-CORE
  defaultWarehouseId                       String?                      @map("default_warehouse_id") @db.VarChar(15)
  tenant                                   Nx99Tenant                   @relation("R_Nx01Partner_tenantId", fields: [tenantId], references: [id])
  customerGrade                            Nx01CustomerGrade?           @relation("R_Nx01Partner_customerGradeId", fields: [customerGradeId], references: [id])
  supplierGrade                            Nx01SupplierGrade?           @relation("R_Nx01Partner_supplierGradeId", fields: [supplierGradeId], references: [id])
  salesUser                                Nx01User?                    @relation("R_Nx01Partner_salesUserId", fields: [salesUserId], references: [id])
