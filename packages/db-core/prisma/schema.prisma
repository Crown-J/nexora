  /// 鄉鎮代碼（如 WSN）；啟用最低需求版本：LITE
  code      String   @db.VarChar(5)
  /// 中文名（如 文山區）；啟用最低需求版本：LITE
  name      String   @db.VarChar(20)
  /// 英文名（如 Wenshan District）；啟用最低需求版本：LITE
  nameEn    String?  @map("name_en") @db.VarChar(50)
  /// 3 碼郵遞區號（中華郵政、選縣市→鄉鎮自動帶；02 對齊第二批 A 軌 CP1 2026-06-06 新增）；啟用最低需求版本：LITE
  postalCode String? @map("postal_code") @db.VarChar(3)
  /// 區內排序；啟用最低需求版本：LITE
  sortOrder Int      @default(0) @map("sort_order")
  /// 是否啟用；啟用最低需求版本：LITE
  isActive  Boolean  @default(true) @map("is_active")
  /// 建立時間；啟用最低需求版本：LITE
  createdAt DateTime @default(now()) @map("created_at")
  /// 建立人；啟用最低需求版本：LITE
  createdBy String   @map("created_by") @db.VarChar(15)
  /// 更新時間；啟用最低需求版本：LITE
  updatedAt DateTime @updatedAt @map("updated_at")
  /// 更新人；啟用最低需求版本：LITE
  updatedBy String   @map("updated_by") @db.VarChar(15)

  city                                      Nx01City                     @relation("R_Nx01District_cityId", fields: [cityId], references: [id])
  rev_Nx01Street_districtId                 Nx01Street[]                 @relation("R_Nx01Street_districtId")
  rev_Nx01PartnerAddress_districtId         Nx01PartnerAddress[]         @relation("R_Nx01PartnerAddress_districtId")
  rev_Nx01User_householdDistrictId          Nx01User[]                   @relation("R_Nx01User_householdDistrictId")
  rev_Nx01User_mailingDistrictId            Nx01User[]                   @relation("R_Nx01User_mailingDistrictId")
  rev_Nx01Warehouse_districtId              Nx01Warehouse[]              @relation("R_Nx01Warehouse_districtId")

  @@unique([cityId, code])
  @@unique([cityId, name])
  @@map("nx01_district")
}

/// =======================================================
/// Nx01Street — DB table `nx01_street`（NX01-09 地址型錄系統 v1.0）
/// =======================================================
model Nx01Street {
  /// [NX01]+[STRT]+[7碼流水號]，EX : NX01STRT0000001；啟用最低需求版本：LITE
  id          String   @id @default(dbgenerated("gen_nx01_street_id()")) @db.VarChar(15)
  /// 所屬鄉鎮 ID（FK to nx01_district）；啟用最低需求版本：LITE
  districtId  String   @map("district_id") @db.VarChar(15)
  /// 路街名（如 羅斯福路六段）；啟用最低需求版本：LITE
  name        String   @db.VarChar(100)
  /// 英文名（如 Sec. 6, Roosevelt Rd.）；啟用最低需求版本：LITE
  nameEn      String?  @map("name_en") @db.VarChar(200)
  /// 3 碼郵遞區號（如 116）；啟用最低需求版本：LITE
  zipcode3    String   @map("zipcode_3") @db.VarChar(3)
  /// 3+3 完整郵遞區號（如 116-051）；啟用最低需求版本：LITE
  zipcodeFull String   @map("zipcode_full") @db.VarChar(7)
  /// 是否啟用；啟用最低需求版本：LITE
  isActive    Boolean  @default(true) @map("is_active")
  /// 建立時間；啟用最低需求版本：LITE
  createdAt   DateTime @default(now()) @map("created_at")
  /// 建立人；啟用最低需求版本：LITE
  createdBy   String   @map("created_by") @db.VarChar(15)
  /// 更新時間；啟用最低需求版本：LITE
  updatedAt   DateTime @updatedAt @map("updated_at")
  /// 更新人；啟用最低需求版本：LITE
  updatedBy   String   @map("updated_by") @db.VarChar(15)

  district                                Nx01District                 @relation("R_Nx01Street_districtId", fields: [districtId], references: [id])
  rev_Nx01Warehouse_streetId              Nx01Warehouse[]              @relation("R_Nx01Warehouse_streetId")

  @@unique([districtId, name])
  @@map("nx01_street")
}

/// =======================================================
/// Nx01PartCompatGroup — DB table `nx01_part_compat_group`（02 對齊第二批 C 軌 CP2-c：通用件群組）
/// =======================================================
/// 業務範式：同一群組內所有 part 互為替代品（如「機油芯通用群」內 BOSCH F004 / MANN W940/1 / MAHLE OC91）
model Nx01PartCompatGroup {
  /// [NX01]+[PCGP]+[7碼流水號]；啟用最低需求版本：LITE
  id        String                       @id @default(dbgenerated("gen_nx01_part_compat_group_id()")) @db.VarChar(15)
  /// 租戶 ID（外鍵）；啟用最低需求版本：LITE
  tenantId  String                       @map("tenant_id") @db.VarChar(15)
  /// 群組代碼（tenant 內唯一、業務命名如 OILFILT-1.6L）；啟用最低需求版本：LITE
  code      String                       @db.VarChar(30)
  /// 群組名稱（顯示用、例：1.6L 機油芯通用群）；啟用最低需求版本：LITE
  name      String                       @db.VarChar(100)
  /// 備註（搭配車型 / 排氣量 / 使用注意）；啟用最低需求版本：LITE
  remark    String?                      @db.VarChar(200)
  sortNo    Int                          @default(0) @map("sort_no")
  isActive  Boolean                      @default(true) @map("is_active")
  createdAt DateTime                     @default(now()) @map("created_at")
  createdBy String                       @map("created_by") @db.VarChar(15)
  updatedAt DateTime                     @updatedAt @map("updated_at")
  updatedBy String                       @map("updated_by") @db.VarChar(15)
  tenant    Nx99Tenant                   @relation("R_Nx01PartCompatGroup_tenantId", fields: [tenantId], references: [id])
  members   Nx01PartCompatGroupMember[]  @relation("R_Nx01PartCompatGroupMember_groupId")

  @@unique([tenantId, code])
  @@map("nx01_part_compat_group")
}

/// =======================================================
/// Nx01PartCompatGroupMember — DB table `nx01_part_compat_group_member`
/// =======================================================
/// 多對多 member：part ↔ group + role + 各自售價 + 雙向旗標
model Nx01PartCompatGroupMember {
  /// [NX01]+[PCMB]+[7碼流水號]；啟用最低需求版本：LITE
  id              String              @id @default(dbgenerated("gen_nx01_part_compat_group_member_id()")) @db.VarChar(15)
  tenantId        String              @map("tenant_id") @db.VarChar(15)
  groupId         String              @map("group_id") @db.VarChar(15)
  partId          String              @map("part_id") @db.VarChar(15)
  /// 角色（1=PRIMARY 主件 / 2=ALT 替代品）；啟用最低需求版本：LITE
  role            Int                 @default(2) @db.SmallInt
  /// 群組內專屬售價（null=用 part.priceA 預設；有值=群組覆寫）；啟用最低需求版本：LITE
  customPrice     Decimal?            @map("custom_price") @db.Decimal(14, 2)
  /// 雙向旗標（true=A↔B 互為替代品；false=單向 A→B、B 找不到 A）；啟用最低需求版本：LITE
  isBidirectional Boolean             @default(true) @map("is_bidirectional")
  sortNo          Int                 @default(0) @map("sort_no")
  remark          String?             @db.VarChar(200)
  isActive        Boolean             @default(true) @map("is_active")
  createdAt       DateTime            @default(now()) @map("created_at")
  createdBy       String              @map("created_by") @db.VarChar(15)
  updatedAt       DateTime            @updatedAt @map("updated_at")
  updatedBy       String              @map("updated_by") @db.VarChar(15)
  tenant          Nx99Tenant          @relation("R_Nx01PartCompatGroupMember_tenantId", fields: [tenantId], references: [id])
  group           Nx01PartCompatGroup @relation("R_Nx01PartCompatGroupMember_groupId", fields: [groupId], references: [id], onDelete: Cascade)
  part            Nx01Part            @relation("R_Nx01PartCompatGroupMember_partId", fields: [partId], references: [id], onDelete: Cascade)

  @@unique([tenantId, groupId, partId])
  @@index([tenantId, partId])
  @@map("nx01_part_compat_group_member")
}

/// =======================================================
/// Nx01Region — DB table `nx01_region`（02 對齊第二批 C 軌 CP1：客戶地區下拉）
/// =======================================================
/// 地區小型主檔（tenant 內、不入 partner code 編號、純展示分類）。
/// 業務範例：北部 / 中部 / 南部 / 東部 / 離島；或更細：台北 / 新北 / 桃園 / 新竹 ...
model Nx01Region {
  /// [NX01]+[REGN]+[7碼流水號]，EX : NX01REGN0000001；啟用最低需求版本：LITE
  id        String      @id @default(dbgenerated("gen_nx01_region_id()")) @db.VarChar(15)
  /// 租戶 ID（外鍵）；啟用最低需求版本：LITE
  tenantId  String      @map("tenant_id") @db.VarChar(15)
  /// 地區代碼（tenant 內唯一、業務自行決定如 N/C/S/E 或 TPE/TAO 等）；啟用最低需求版本：LITE
  code      String      @db.VarChar(20)
  /// 地區名稱（顯示用）；啟用最低需求版本：LITE
  name      String      @db.VarChar(50)
  /// 排序用；啟用最低需求版本：LITE
  sortNo    Int         @default(0) @map("sort_no")
  /// 是否啟用；啟用最低需求版本：LITE
  isActive  Boolean     @default(true) @map("is_active")
  /// 建立時間；啟用最低需求版本：LITE
  createdAt DateTime    @default(now()) @map("created_at")
  /// 建立人；啟用最低需求版本：LITE
  createdBy String      @map("created_by") @db.VarChar(15)
  /// 更新時間；啟用最低需求版本：LITE
  updatedAt DateTime    @updatedAt @map("updated_at")
  /// 更新人；啟用最低需求版本：LITE
  updatedBy String      @map("updated_by") @db.VarChar(15)
  tenant    Nx99Tenant  @relation("R_Nx01Region_tenantId", fields: [tenantId], references: [id])
  rev_Nx01Partner_regionId Nx01Partner[] @relation("R_Nx01Partner_regionId")

  @@unique([tenantId, code])
  @@map("nx01_region")
}

/// =======================================================
/// Nx01PartnerAddress — DB table `nx01_partner_address`（02 對齊第二批 A 軌 CP2 2026-06-06）
/// =======================================================
/// 合 Nx01PartnerBillingAddress + Nx01PartnerShippingAddress 統一衛星表。
/// addressType: BILLING 收帳（同 partner 內最多 1 筆）/ SHIPPING 送貨（多筆、一筆 isDefault）。
/// 國別分流：countryId=null 預設 TW 走 city/district/postalCode 字典 + 結構化門牌；
///           countryId=非 TW 走 freeformAddress + postalCode 自由填。
/// =======================================================
/// Nx01PartnerContact — DB table `nx01_partner_contact`（02 第三批 T2 2026-06-07 聯絡窗口子表）
/// =======================================================
/// 客戶（partner）多筆聯絡窗口：對方公司不同窗口（採購／業務／會計／倉管 等）
model Nx01PartnerContact {
  id          String      @id @default(dbgenerated("gen_nx01_partner_contact_id()")) @db.VarChar(15)
  tenantId    String      @map("tenant_id") @db.VarChar(15)
  partnerId   String      @map("partner_id") @db.VarChar(15)
  contactName String      @map("contact_name") @db.VarChar(50)
  /// 職務部門（自由文字、不綁本租戶 nx01_department、對方公司部門名）
  jobTitle    String?     @map("job_title") @db.VarChar(50)
  phone       String?     @db.VarChar(30)
  phoneExt    String?     @map("phone_ext") @db.VarChar(20)
  mobile      String?     @db.VarChar(30)
  email       String?     @db.VarChar(100)
  note        String?     @db.VarChar(200)
  sortNo      Int         @default(0) @map("sort_no")
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")
  createdBy   String      @map("created_by") @db.VarChar(15)
  updatedAt   DateTime    @updatedAt @map("updated_at")
  updatedBy   String      @map("updated_by") @db.VarChar(15)
  tenant      Nx99Tenant  @relation("R_Nx01PartnerContact_tenantId", fields: [tenantId], references: [id])
  partner     Nx01Partner @relation("R_Nx01PartnerContact_partnerId", fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([tenantId, partnerId])
  @@map("nx01_partner_contact")
}

model Nx01PartnerAddress {
  id              String        @id @default(dbgenerated("gen_nx01_partner_address_id()")) @db.VarChar(15)
  tenantId        String        @map("tenant_id") @db.VarChar(15)
  partnerId       String        @map("partner_id") @db.VarChar(15)
  /// 地址類型：BILLING 收帳 / SHIPPING 送貨
  addressType     String        @map("address_type") @db.VarChar(10)
  /// 顯示用標籤（送貨用、如「總公司」「桃園倉」）
  label           String?       @db.VarChar(50)
  /// 預設旗標（同 partner+type 內最多 1 筆 isDefault=true、partial unique）
  isDefault       Boolean       @default(false) @map("is_default")
  /// 國別 FK（null 視為 TW 預設、走字典；非 null 走 freeform）
  countryId       String?       @map("country_id") @db.VarChar(15)
  /// TW 字典：縣市
  cityId          String?       @map("city_id") @db.VarChar(15)
  /// TW 字典：鄉鎮市區（從 district 自動帶 postalCode）
  districtId      String?       @map("district_id") @db.VarChar(15)
  /// 3 碼郵遞區號（TW 從 district 帶入、國外手填）
  postalCode      String?       @map("postal_code") @db.VarChar(10)
  /// 結構化門牌（TW 用、國外可全空走 freeform）
  streetName      String?       @map("street_name") @db.VarChar(100)
  lane            String?       @db.VarChar(20)
  alley           String?       @db.VarChar(20)
  buildingNo      String?       @map("building_no") @db.VarChar(20)
  buildingSubNo   String?       @map("building_sub_no") @db.VarChar(20)
  floor           String?       @db.VarChar(20)
  roomNo          String?       @map("room_no") @db.VarChar(20)
  /// 國外自由填整段地址（country 非 TW 時用）
  freeformAddress String?       @map("freeform_address") @db.VarChar(500)
  /// 收件 / 送達聯絡
  recipientName   String?       @map("recipient_name") @db.VarChar(50)
  recipientPhone  String?       @map("recipient_phone") @db.VarChar(50)
  note            String?       @db.VarChar(200)
  isActive        Boolean       @default(true) @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at")
  createdBy       String        @map("created_by") @db.VarChar(15)
  updatedAt       DateTime      @updatedAt @map("updated_at")
  updatedBy       String        @map("updated_by") @db.VarChar(15)
  tenant          Nx99Tenant    @relation("R_Nx01PartnerAddress_tenantId", fields: [tenantId], references: [id])
  partner         Nx01Partner   @relation("R_Nx01PartnerAddress_partnerId", fields: [partnerId], references: [id], onDelete: Cascade)
  country         Nx01Country?  @relation("R_Nx01PartnerAddress_countryId", fields: [countryId], references: [id], onDelete: SetNull)
  city            Nx01City?     @relation("R_Nx01PartnerAddress_cityId", fields: [cityId], references: [id], onDelete: SetNull)
  district        Nx01District? @relation("R_Nx01PartnerAddress_districtId", fields: [districtId], references: [id], onDelete: SetNull)

  rev_Nx02Po_shipToAddressId Nx02Po[] @relation("R_Nx02Po_shipToAddressId")

  @@index([tenantId, partnerId, addressType])
  @@map("nx01_partner_address")
}

/// =======================================================
/// Nx01PartnerGradeHistory — DB table `nx01_partner_grade_history`
/// 客戶等級變更歷史（對齊 Crown 2026-05-29 Q6 拍板、PENDING/APPROVED/REJECTED 流程）
/// 業務員申請、G 核可後 partner.customer_grade_id 同步更新、PENDING/REJECTED 不影響既有 QT
/// =======================================================
model Nx01PartnerGradeHistory {
  /// [NX01]+[PGHI]+[7碼流水號]，EX : NX01PGHI0000001；啟用最低需求版本：LITE-CORE
  id           String            @id @default(dbgenerated("gen_nx01_partner_grade_history_id()")) @db.VarChar(15)
  /// 租戶 ID（外鍵）；啟用最低需求版本：LITE-CORE
  tenantId     String            @map("tenant_id") @db.VarChar(15)
  /// 對象客戶 ID（FK nx01_partner、partnerType IN ('C','O')）；啟用最低需求版本：LITE-CORE
  partnerId    String            @map("partner_id") @db.VarChar(15)
  /// 變更前等級 ID（FK nx01_customer_grade）；啟用最低需求版本：LITE-CORE
  oldGradeId   String            @map("old_grade_id") @db.VarChar(15)
  /// 變更後等級 ID（FK nx01_customer_grade）；啟用最低需求版本：LITE-CORE
  newGradeId   String            @map("new_grade_id") @db.VarChar(15)
  /// 變更狀態（PENDING/APPROVED/REJECTED）。APPROVED 後 partner.customer_grade_id 同步更新；啟用最低需求版本：LITE-CORE
  status       String            @default("PENDING") @db.VarChar(30)
  /// 申請人（業務員、使用者 ID、純 VarChar 對齊既有 approvedBy 範式不建 FK）；啟用最低需求版本：LITE-CORE
  requestedBy  String            @map("requested_by") @db.VarChar(15)
  /// 申請時間；啟用最低需求版本：LITE-CORE
  requestedAt  DateTime          @default(now()) @map("requested_at")
  /// 申請理由（必填）；啟用最低需求版本：LITE-CORE
  reason       String            @db.VarChar(200)
  /// 核可人（G/負責人、使用者 ID、APPROVED 後填）；啟用最低需求版本：LITE-CORE
  approvedBy   String?           @map("approved_by") @db.VarChar(15)
  /// 核可時間（APPROVED 後填）；啟用最低需求版本：LITE-CORE
  approvedAt   DateTime?         @map("approved_at")
  /// 退件原因（REJECTED 後必填）；啟用最低需求版本：LITE-CORE
  rejectReason String?           @map("reject_reason") @db.VarChar(200)
  /// 建立時間；啟用最低需求版本：LITE-CORE
  createdAt    DateTime          @default(now()) @map("created_at")
  /// 建立人；啟用最低需求版本：LITE-CORE
  createdBy    String            @map("created_by") @db.VarChar(15)
  /// 更新時間；啟用最低需求版本：LITE-CORE
  updatedAt    DateTime          @updatedAt @map("updated_at")
  /// 更新人；啟用最低需求版本：LITE-CORE
  updatedBy    String            @map("updated_by") @db.VarChar(15)
  tenant       Nx99Tenant        @relation("R_Nx01PartnerGradeHistory_tenantId", fields: [tenantId], references: [id])
  partner      Nx01Partner       @relation("R_Nx01PartnerGradeHistory_partnerId", fields: [partnerId], references: [id])
  oldGrade     Nx01CustomerGrade @relation("R_Nx01PartnerGradeHistory_oldGradeId", fields: [oldGradeId], references: [id])
  newGrade     Nx01CustomerGrade @relation("R_Nx01PartnerGradeHistory_newGradeId", fields: [newGradeId], references: [id])

  @@index([tenantId, partnerId])
  @@index([tenantId, status])
  @@map("nx01_partner_grade_history")
}

/// =======================================================
/// Nx01PhoneticDictionary — DB table `nx01_phonetic_dictionary`
/// 全域字典（無 tenantId）、SYSADMIN 維護、漢字 → 注音對照表
/// 對應規格：docs/nx01/spec/intent/nx01-10-phonetic-search.md v1.0 §4.1
/// =======================================================
model Nx01PhoneticDictionary {
  /// [NX01]+[PHDC]+[7碼流水號]，EX : NX01PHDC0000001；啟用最低需求版本：LITE
  id              String   @id @default(dbgenerated("gen_nx01_phonetic_dictionary_id()")) @db.VarChar(15)
  /// 漢字（單字元、全域 unique）；啟用最低需求版本：LITE
  character       String   @db.VarChar(4)
  /// 主要注音（如 ㄅㄧˋ）；啟用最低需求版本：LITE
  primaryPhonetic String   @map("primary_phonetic") @db.VarChar(10)
  /// 替代注音陣列（多音字、0~5 個）；啟用最低需求版本：LITE
  altPhonetics    String[] @default([]) @map("alt_phonetics")
  /// 主要聲母（從 primary_phonetic 抽出、如 ㄅ）；啟用最低需求版本：LITE
  primaryInitial  String   @map("primary_initial") @db.VarChar(2)
  /// 使用頻率（多音字優先序、系統統計）；啟用最低需求版本：LITE
  usageFreq       Int      @default(0) @map("usage_freq")
  /// 是否啟用（SYSADMIN 可停用錯字）；啟用最低需求版本：LITE
  isActive        Boolean  @default(true) @map("is_active")
  /// 建立時間；啟用最低需求版本：LITE
  createdAt       DateTime @default(now()) @map("created_at")
  /// 建立人；啟用最低需求版本：LITE
  createdBy       String   @map("created_by") @db.VarChar(15)
  /// 更新時間；啟用最低需求版本：LITE
  updatedAt       DateTime @updatedAt @map("updated_at")
  /// 更新人；啟用最低需求版本：LITE
  updatedBy       String   @map("updated_by") @db.VarChar(15)

  @@unique([character])
  @@index([primaryInitial])
  @@map("nx01_phonetic_dictionary")
}

/// =======================================================
/// Nx01PhoneticIndex — DB table `nx01_phonetic_index`
/// 跨主檔注音碼索引、trigger 維護、每租戶獨立
/// 對應規格：docs/nx01/spec/intent/nx01-10-phonetic-search.md v1.0 §4.2
/// =======================================================
model Nx01PhoneticIndex {
  /// [NX01]+[PHIX]+[7碼流水號]，EX : NX01PHIX0000001；啟用最低需求版本：LITE
  id           String     @id @default(dbgenerated("gen_nx01_phonetic_index_id()")) @db.VarChar(15)
  /// 租戶 ID；啟用最低需求版本：LITE
  tenantId     String     @map("tenant_id") @db.VarChar(15)
  /// 來源表名（如 nx01_part / nx01_partner / nx01_user）；啟用最低需求版本：LITE
  sourceTable  String     @map("source_table") @db.VarChar(50)
  /// 來源主檔 ID（軟連結、不用 FK constraint）；啟用最低需求版本：LITE
  sourceId     String     @map("source_id") @db.VarChar(15)
  /// 來源欄位名（如 name / display_name）；啟用最低需求版本：LITE
  sourceField  String     @map("source_field") @db.VarChar(50)
  /// 來源文字（快搜時顯示用）；啟用最低需求版本：LITE
  sourceText   String     @map("source_text") @db.VarChar(500)
  /// 聲母碼（如 ㄅㄓㄑ、前綴匹配用）；啟用最低需求版本：LITE
  phoneticCode String     @map("phonetic_code") @db.VarChar(50)
  /// 完整注音（如 ㄅㄧˋ ㄓㄣˋ ㄑㄧˋ、顯示用）；啟用最低需求版本：LITE
  phoneticFull String     @map("phonetic_full") @db.VarChar(200)
  /// 是否業務人員手動改（手動改後 trigger 不再覆蓋）；啟用最低需求版本：LITE
  isManual     Boolean    @default(false) @map("is_manual")
  /// 建立時間；啟用最低需求版本：LITE
  createdAt    DateTime   @default(now()) @map("created_at")
  /// 建立人（trigger=SYSADMIN ID / 手動改=該使用者）；啟用最低需求版本：LITE
  createdBy    String     @map("created_by") @db.VarChar(15)
  /// 更新時間；啟用最低需求版本：LITE
  updatedAt    DateTime   @updatedAt @map("updated_at")
  /// 更新人；啟用最低需求版本：LITE
  updatedBy    String     @map("updated_by") @db.VarChar(15)
  tenant       Nx99Tenant @relation("R_Nx01PhoneticIndex_tenantId", fields: [tenantId], references: [id])

  @@unique([tenantId, sourceTable, sourceId])
  @@index([tenantId, phoneticCode])
  @@map("nx01_phonetic_index")
}

/// =======================================================
