/// =======================================================
/// Nx01PartGroup — DB table `nx01_part_group`
/// =======================================================
/// =======================================================
/// Nx01PartPhoto — DB table `nx01_part_photo`（02 第三批 T4 2026-06-07）
/// =======================================================
/// 零件照片子表：每顆 part 最多 5 張、sortNo=0 為主圖。
/// storageKey 由 FileUploadService 產（{tenantId}/part-photo/{yyyy}/{mm}/{uuid}{ext}）。
/// dev 用 local filesystem、production 後續可換 R2 / S3 不動 caller。
model Nx01PartPhoto {
  id              String     @id @default(dbgenerated("gen_nx01_part_photo_id()")) @db.VarChar(15)
  tenantId        String     @map("tenant_id") @db.VarChar(15)
  partId          String     @map("part_id") @db.VarChar(15)
  /// FileUploadService 產的 storage key（{tenantId}/part-photo/{yyyy}/{mm}/{uuid}{ext}）
  storageKey      String     @map("storage_key") @db.VarChar(255)
  mimeType        String     @map("mime_type") @db.VarChar(50)
  fileSize        Int        @map("file_size")
  origFilename    String?    @map("orig_filename") @db.VarChar(200)
  /// 排序：sortNo=0 為主圖、其他依數字遞增；同 part 內可重排
  sortNo          Int        @default(0) @map("sort_no")
  uploaderUserId  String     @map("uploader_user_id") @db.VarChar(15)
  createdAt       DateTime   @default(now()) @map("created_at")
  tenant          Nx99Tenant @relation("R_Nx01PartPhoto_tenantId", fields: [tenantId], references: [id])
  part            Nx01Part   @relation("R_Nx01PartPhoto_partId", fields: [partId], references: [id], onDelete: Cascade)

  @@index([tenantId, partId, sortNo])
  @@map("nx01_part_photo")
}

model Nx01PartGroup {
  /// [NX01]+[PAGR]+[7碼流水號]，EX : NX01PAGR0000001；啟用最低需求版本：LITE
  id                       String     @id @default(dbgenerated("gen_nx01_part_group_id()")) @db.VarChar(15)
  /// 租戶 ID（外鍵）；啟用最低需求版本：LITE
  tenantId                 String     @map("tenant_id") @db.VarChar(15)
  /// 族群代碼（唯一）；啟用最低需求版本：LITE
  code                     String     @db.VarChar(30)
  /// 族群名稱（使用者自訂）；啟用最低需求版本：LITE
  name                     String     @db.VarChar(100)
  /// 預設建議保存期限（月、選填）；02 第四批 軌 6 2026-06-07 新增
  /// 新增零件選此族群時、Part.shelfLifeMonths 預設帶入此值、業務員可覆寫（範式同 CustomerGrade.marginPct + Partner.customMarginPct）。
  defaultShelfLifeMonths   Int?       @map("default_shelf_life_months")
  /// 排序；啟用最低需求版本：LITE
  sortNo                   Int        @default(0) @map("sort_no")
  /// 是否啟用；啟用最低需求版本：LITE
  isActive                 Boolean    @default(true) @map("is_active")
  /// 建立時間。；啟用最低需求版本：LITE
  createdAt                DateTime   @default(now()) @map("created_at")
  /// 建立人（必填；系統操作帶入使用者 ID；DB 匯入填系統管理員 ID）；啟用最低需求版本：LITE
  createdBy                String     @map("created_by") @db.VarChar(15)
  /// 更新時間。；啟用最低需求版本：LITE
  updatedAt                DateTime   @updatedAt @map("updated_at")
  /// 更新人（必填；系統操作帶入使用者 ID；DB 匯入填系統管理員 ID）；啟用最低需求版本：LITE
  updatedBy                String     @map("updated_by") @db.VarChar(15)
  tenant                   Nx99Tenant @relation("R_Nx01PartGroup_tenantId", fields: [tenantId], references: [id])
  rev_Nx01Part_partGroupId Nx01Part[] @relation("R_Nx01Part_partGroupId")

  @@unique([tenantId, code])
  @@map("nx01_part_group")
}

/// =======================================================
