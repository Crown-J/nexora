  partVersion        Nx01PartVersion? @relation("R_Nx03StockTakeItem_partVersionId", fields: [partVersionId], references: [id])
  warehouse          Nx01Warehouse    @relation("R_Nx03StockTakeItem_warehouseId", fields: [warehouseId], references: [id])
  location           Nx01Location     @relation("R_Nx03StockTakeItem_locationId", fields: [locationId], references: [id])

  @@map("nx03_stock_take_item")
