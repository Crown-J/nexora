  displacementCc                      Int?                      @map("displacement_cc")
  /// 備註說明；啟用最低需求版本：LITE
  remark                              String?                   @db.VarChar(200)
  /// 排序用；啟用最低需求版本：LITE
  sortNo                              Int                       @default(0) @map("sort_no")
  /// 是否啟用；啟用最低需求版本：LITE
  isActive                            Boolean                   @default(true) @map("is_active")
  /// 建立時間；啟用最低需求版本：LITE
  createdAt                           DateTime                  @default(now()) @map("created_at")
  /// 建立人；啟用最低需求版本：LITE
  createdBy                           String                    @map("created_by") @db.VarChar(15)
  /// 更新時間；啟用最低需求版本：LITE
  updatedAt                           DateTime                  @updatedAt @map("updated_at")
  /// 更新人；啟用最低需求版本：LITE
  updatedBy                           String                    @map("updated_by") @db.VarChar(15)
  tenant                              Nx99Tenant                @relation("R_Nx01Model_tenantId", fields: [tenantId], references: [id])
  /// W6 [3-8] Phase 5 2026-06-06 品牌合併（SET NOT NULL）
  brand                               Nx01Brand                 @relation("R_Nx01Model_brandId", fields: [brandId], references: [id], onDelete: Restrict)
  rev_Nx01PartModel_modelId           Nx01PartModel[]           @relation("R_Nx01PartModel_modelId")
  rev_Nx03BrandAllocationRule_modelId Nx03BrandAllocationRule[] @relation("R_Nx03BrandAllocationRule_modelId")
  rev_Nx09VinLookup_modelId           Nx09VinLookup[]           @relation("R_Nx09VinLookup_modelId")
  rev_Nx09RepairSop_carModelFilter    Nx09RepairSop[]           @relation("R_Nx09RepairSop_carModelFilter")

  @@unique([tenantId, code])
  @@index([tenantId, brandId])
  @@index([tenantId, modelYearFrom])
  @@map("nx01_model")
}

/// =======================================================
/// Nx01PartVersion — DB table `nx01_part_version`
/// 料號版本紀錄（全 snapshot 範式、Q1=A 拍板）
/// 對應規格：docs/nx01/spec/intent/nx01-17-part-version-relation.md v1.0
/// =======================================================
model Nx01PartVersion {
  /// [NX01]+[PAVE]+[7碼流水號]；啟用最低需求版本：LITE
  id            String    @id @default(dbgenerated("gen_nx01_part_version_id()")) @db.VarChar(15)
  /// 租戶 ID；啟用最低需求版本：LITE
  tenantId      String    @map("tenant_id") @db.VarChar(15)
  /// 對應 part FK；啟用最低需求版本：LITE
  partId        String    @map("part_id") @db.VarChar(15)
  /// 版本號（每 part 從 1 起算、連續編號）；啟用最低需求版本：LITE
  versionNo     Int       @map("version_no")
  /// 生效起始日；啟用最低需求版本：LITE
  effectiveFrom DateTime  @map("effective_from")
  /// 結束日（nullable、現役留空）；啟用最低需求版本:LITE
  effectiveTo   DateTime? @map("effective_to")

  /// 完整 snapshot 9 欄位（Q1=A 拍板：每次 part update 完整 copy）
  codeSnapshot        String   @map("code_snapshot") @db.VarChar(50)
  nameSnapshot        String   @map("name_snapshot") @db.VarChar(200)
  partBrandIdSnapshot String?  @map("part_brand_id_snapshot") @db.VarChar(15)
  countryIdSnapshot   String?  @map("country_id_snapshot") @db.VarChar(15)
  specSnapshot        String?  @map("spec_snapshot") @db.VarChar(200)
  priceASnapshot      Decimal? @map("price_a_snapshot") @db.Decimal(14, 4)
  priceBSnapshot      Decimal? @map("price_b_snapshot") @db.Decimal(14, 4)
  priceCSnapshot      Decimal? @map("price_c_snapshot") @db.Decimal(14, 4)
  priceDSnapshot      Decimal? @map("price_d_snapshot") @db.Decimal(14, 4)

  /// 變動原因（業務人員填、稽核用）；啟用最低需求版本：LITE
  changeReason                           String?                @map("change_reason") @db.VarChar(500)
  /// 建立時間；啟用最低需求版本：LITE
  createdAt                              DateTime               @default(now()) @map("created_at")
  /// 建立人；啟用最低需求版本：LITE
  createdBy                              String                 @map("created_by") @db.VarChar(15)
  /// 更新時間；啟用最低需求版本：LITE
  updatedAt                              DateTime               @updatedAt @map("updated_at")
  /// 更新人；啟用最低需求版本：LITE
  updatedBy                              String                 @map("updated_by") @db.VarChar(15)
  tenant                                 Nx99Tenant             @relation("R_Nx01PartVersion_tenantId", fields: [tenantId], references: [id])
  part                                   Nx01Part               @relation("R_Nx01PartVersion_partId", fields: [partId], references: [id])
  rev_Nx03StockLedger_partVersionId      Nx03StockLedger[]      @relation("R_Nx03StockLedger_partVersionId")
  rev_Nx03InitItem_partVersionId         Nx03InitItem[]         @relation("R_Nx03InitItem_partVersionId")
  rev_Nx03StItem_partVersionId           Nx03StItem[]           @relation("R_Nx03StItem_partVersionId")
  rev_Nx03StockTakeItem_partVersionId    Nx03StockTakeItem[]    @relation("R_Nx03StockTakeItem_partVersionId")
  rev_Nx03DisposalItem_partVersionId     Nx03DisposalItem[]     @relation("R_Nx03DisposalItem_partVersionId")
  rev_Nx03ConversionInput_partVersionId  Nx03ConversionInput[]  @relation("R_Nx03ConversionInput_partVersionId")
  rev_Nx03ConversionOutput_partVersionId Nx03ConversionOutput[] @relation("R_Nx03ConversionOutput_partVersionId")
  rev_Nx03IssueReport_partVersionId      Nx03IssueReport[]      @relation("R_Nx03IssueReport_partVersionId")

  @@unique([tenantId, partId, versionNo])
  @@index([tenantId, partId])
  @@index([tenantId, effectiveFrom])
  @@map("nx01_part_version")
}

