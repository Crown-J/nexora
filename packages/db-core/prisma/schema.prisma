  /// 過帳人（POSTED 才有）；啟用最低需求版本：LITE
  postedBy       String?                @map("posted_by") @db.VarChar(15)
  /// 作廢時間；啟用最低需求版本：LITE
  voidedAt       DateTime?              @map("voided_at")
  /// 作廢人；啟用最低需求版本：LITE
  voidedBy       String?                @map("voided_by") @db.VarChar(15)
  tenant         Nx99Tenant             @relation("R_Nx03Conversion_tenantId", fields: [tenantId], references: [id])
  warehouse      Nx01Warehouse          @relation("R_Nx03Conversion_warehouseId", fields: [warehouseId], references: [id])
  inputs         Nx03ConversionInput[]  @relation("R_Nx03ConversionInput_conversionId")
  outputs        Nx03ConversionOutput[] @relation("R_Nx03ConversionOutput_conversionId")

  @@unique([docNo])
