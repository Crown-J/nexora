/// =======================================================
/// Nx01Permission — DB table `nx01_permission`
/// v1.2 對齊軌 A+B：系統權限目錄（無 tenant scope、所有租戶共用）
/// =======================================================
model Nx01Permission {
  /// [NX01]+[PERM]+[7碼流水號]，EX : NX01PERM0000001
  id          String   @id @default(dbgenerated("gen_nx01_permission_id()")) @db.VarChar(15)
  /// 權限代碼（系統唯一），例：sale.quote.list
  code        String   @unique @db.VarChar(60)
  /// 模組分類，例：sale / purchase / inventory / finance / report / master / settings
  moduleCode  String   @map("module_code") @db.VarChar(20)
  /// 子分類，例：quote / so / sr / rfq / po
  category    String   @db.VarChar(40)
  /// 動作，例：list / view / create / edit / delete / approve / post / export
  action      String   @db.VarChar(20)
  /// 顯示名稱，例：報價單.檢視
  name        String   @db.VarChar(80)
  /// 說明（可選）
  description String?  @db.VarChar(200)
  /// 排序用
  sortNo      Int      @default(0) @map("sort_no")
  /// 是否啟用
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rev_Nx01RolePermission_permissionId Nx01RolePermission[] @relation("R_Nx01RolePermission_permissionId")

  @@index([moduleCode, category, action])
  @@map("nx01_permission")
}

/// =======================================================
