/// =======================================================
/// Nx01Site — DB table `nx01_site`（據點：公司物理分點，為倉庫之上一層；LITE 預設 1 筆「總公司」）
/// =======================================================
model Nx01Site {
  /// [NX01]+[SITE]+[7碼流水號]，EX : NX01SITE0000001；啟用最低需求版本：LITE
  id                       String          @id @default(dbgenerated("gen_nx01_site_id()")) @db.VarChar(15)
  /// 租戶 ID；啟用最低需求版本：LITE
  tenantId                 String          @map("tenant_id") @db.VarChar(15)
  /// 據點代碼（租戶內唯一），例：HQ、TPE、TXG；啟用最低需求版本：LITE
  code                     String          @db.VarChar(20)
  /// 據點名稱，例：總公司、台北據點、台中據點；啟用最低需求版本：LITE
  name                     String          @db.VarChar(100)
  /// 地址（legacy 自由文字、#23 並存：結構化地址 picker 接上前沿用）；啟用最低需求版本：LITE
  address                  String?         @db.VarChar(200)
  /// 縣市 ID（FK nx01_city、結構化地址、對齊倉庫範式；scalar 並存、待 NX01-04 地址端點接 picker）；啟用最低需求版本：LITE
  cityId                   String?         @map("city_id") @db.VarChar(15)
  /// 鄉鎮市區 ID（FK nx01_district、同上）；啟用最低需求版本：LITE
  districtId               String?         @map("district_id") @db.VarChar(15)
  /// 路街 ID（FK nx01_street、同上）；啟用最低需求版本：LITE
  streetId                 String?         @map("street_id") @db.VarChar(15)
  /// 聯絡電話（選填）；啟用最低需求版本：LITE
  phone                    String?         @db.VarChar(30)
  /// 是否主據點（同 tenant 只 1 筆 is_main=true、partial unique 強制、對齊倉庫 isMain 範式）；啟用最低需求版本：LITE
  isMain                   Boolean         @default(false) @map("is_main")
  /// 排序；啟用最低需求版本：LITE
  sortNo                   Int             @default(0) @map("sort_no")
  /// 是否啟用（停用不刪資料）；啟用最低需求版本：LITE
  isActive                 Boolean         @default(true) @map("is_active")
  createdAt                DateTime        @default(now()) @map("created_at")
  createdBy                String          @map("created_by") @db.VarChar(15)
  updatedAt                DateTime        @updatedAt @map("updated_at")
  updatedBy                String          @map("updated_by") @db.VarChar(15)
  rev_Nx01Warehouse_siteId Nx01Warehouse[] @relation("R_Nx01Warehouse_siteId")
  // 02 第四批 軌 1 2026-06-07：使用者「主要據點」單值 ref（一人一個、forward 視角）
  rev_Nx01User_primarySiteId Nx01User[]    @relation("R_Nx01User_primarySiteId")

  @@unique([tenantId, code])
  @@map("nx01_site")
}

/// =======================================================
/// Nx01Part — DB table `nx01_part`
