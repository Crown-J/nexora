/// audit-02 後記 path C 混合範式（Crown Q-PP-1=C）
/// source 雙來源（Crown Q-S1 範式仿 AR BrandAllocationRule）：S=system 自動 / M=manual 手動
/// 採購建議單列表先查主檔 → fallback Nx02PoItem 歷史推算（PurchaseSuggestionService）
/// 支援歷史版本：unique [tenantId, partnerId, partId, validFrom]、validTo 可空（現役留空）
/// =======================================================
model Nx02PartnerPart {
  /// [NX02]+[PNPT]+[7碼流水號]，EX : NX02PNPT0000001；啟用最低需求版本：LITE-CORE
  id              String      @id @default(dbgenerated("gen_nx02_partner_part_id()")) @db.VarChar(15)
  /// 租戶 ID（外鍵）；啟用最低需求版本：LITE-CORE
  tenantId        String      @map("tenant_id") @db.VarChar(15)
  /// 廠商 ID（FK nx01_partner、application 層 guard partner_type='S' 純供應商、Crown Q-PP-2=a 不在 DB 強制）；啟用最低需求版本：LITE-CORE
  partnerId       String      @map("partner_id") @db.VarChar(15)
  /// 料件 ID（FK nx01_part）；啟用最低需求版本：LITE-CORE
  partId          String      @map("part_id") @db.VarChar(15)
  /// 主要供應商標記（採購建議單列表排序、true=主要、false=次要備援）；啟用最低需求版本：LITE-CORE
  isPrimary       Boolean     @default(false) @map("is_primary")
  /// 廠商料號（Crown Q-PP-3=b 選填、業界 muscle memory 雙料號對應、如 Bosch 自有編號 vs 我方 partNo）；啟用最低需求版本：LITE-CORE
  supplierPartNo  String?     @map("supplier_part_no") @db.VarChar(50)
  /// 預設單價（採購建議單預設值、無歷史時 fallback）；啟用最低需求版本：LITE-CORE
  defaultUnitCost Decimal?    @map("default_unit_cost") @db.Decimal(14, 4)
  /// 預設交期（天數）；啟用最低需求版本：LITE-CORE
  defaultLeadDays Int?        @map("default_lead_days")
  /// 最小訂購量 MOQ；啟用最低需求版本：LITE-CORE
  moq             Decimal?    @db.Decimal(14, 4)
  /// 來源（S=system 自動同步 / M=manual 手動維護、仿 AR BrandAllocationRule Q-S1=A 雙來源並存）；啟用最低需求版本：LITE-CORE
  source          String      @default("S") @db.VarChar(1)
  /// 生效起期（可空、null=從建立時即生效）；啟用最低需求版本：LITE-CORE
  validFrom       DateTime?   @map("valid_from") @db.Date
  /// 生效迄期（null=現役、application 層校驗 validFrom ≤ validTo）；啟用最低需求版本：LITE-CORE
  validTo         DateTime?   @map("valid_to") @db.Date
  /// 是否啟用；啟用最低需求版本：LITE-CORE
  isActive        Boolean     @default(true) @map("is_active")
  /// 備註；啟用最低需求版本：LITE-CORE
  remark          String?     @db.VarChar(200)
  /// 建立時間；啟用最低需求版本：LITE-CORE
  createdAt       DateTime    @default(now()) @map("created_at")
  /// 建立人；啟用最低需求版本：LITE-CORE
  createdBy       String      @map("created_by") @db.VarChar(15)
  /// 更新時間；啟用最低需求版本：LITE-CORE
  updatedAt       DateTime    @updatedAt @map("updated_at")
  /// 更新人；啟用最低需求版本：LITE-CORE
  updatedBy       String      @map("updated_by") @db.VarChar(15)
  tenant          Nx99Tenant  @relation("R_Nx02PartnerPart_tenantId", fields: [tenantId], references: [id])
  partner         Nx01Partner @relation("R_Nx02PartnerPart_partnerId", fields: [partnerId], references: [id])
  part            Nx01Part    @relation("R_Nx02PartnerPart_partId", fields: [partId], references: [id])

  @@unique([tenantId, partnerId, partId, validFrom], map: "nx02_partner_part_tenant_partner_part_valid_from_key")
  @@index([tenantId, partnerId], map: "nx02_partner_part_tenant_partner_idx")
  @@index([tenantId, partId], map: "nx02_partner_part_tenant_part_idx")
  @@index([tenantId, isPrimary], map: "nx02_partner_part_tenant_is_primary_idx")
  @@map("nx02_partner_part")
}

/// =======================================================
/// Nx02Po — DB table `nx02_po`
/// =======================================================
model Nx02Po {
  /// [NX02]+[POHT]+[7碼流水號]，EX : NX02POHT0000001；啟用最低需求版本：PLUS
  id                    String         @id @default(dbgenerated("gen_nx02_po_id()")) @db.VarChar(15)
  /// 租戶ID；啟用最低需求版本：PLUS
  tenantId              String         @map("tenant_id") @db.VarChar(15)
  /// 採購單號（唯一），[PO]+[年月]+[倉別]+[5碼流水號]，EX：PO-202602-Z01-00001；啟用最低需求版本：PLUS
  docNo                 String         @map("doc_no") @db.VarChar(30)
  /// 採購日期；啟用最低需求版本：PLUS
  poDate                DateTime       @map("po_date") @db.Date
  /// 廠商 ID (外鍵)；啟用最低需求版本：PLUS
  supplierId            String         @map("supplier_id") @db.VarChar(15)
  /// 來源單據 id (外鍵)；啟用最低需求版本：PLUS
  rfqId                 String?        @map("rfq_id") @db.VarChar(15)
  /// 幣別 ID (外鍵)；啟用最低需求版本：PLUS
  currencyId            String         @default("TWD") @map("currency_id") @db.VarChar(15)
  /// 單據狀態（DRAFT / CONFIRMED / PARTIAL_RECEIVED / RECEIVED / CLOSED / CANCELLED）；啟用最低需求版本：PLUS
  status                String         @default("DRAFT") @db.VarChar(30)
  /// 小計（明細加總，未稅）；啟用最低需求版本：PLUS
  subtotal              Decimal        @default(0) @db.Decimal(14, 2)
  /// 稅率（預設 5.00）；啟用最低需求版本：PLUS
  taxRate               Decimal        @default(5) @map("tax_rate") @db.Decimal(14, 2)
  /// 稅額（可手動覆寫）；啟用最低需求版本：PLUS
  taxAmount             Decimal        @default(0) @map("tax_amount") @db.Decimal(14, 2)
  /// 總額（subtotal + tax_amount）；啟用最低需求版本：PLUS
  totalAmount           Decimal        @default(0) @map("total_amount") @db.Decimal(14, 2)
  /// 預計到貨日；啟用最低需求版本：PLUS
  expectedDate          DateTime?      @map("expected_date") @db.Date
  /// 備註；啟用最低需求版本：PLUS
  remark                String?        @db.VarChar(200)
  /// 建立時間。；啟用最低需求版本：PLUS
  createdAt             DateTime       @default(now()) @map("created_at")
  /// 建立人（必填；系統操作帶入使用者 ID；DB 匯入填系統管理員 ID）；啟用最低需求版本：PLUS
  createdBy             String         @map("created_by") @db.VarChar(15)
  /// 更新時間。；啟用最低需求版本：PLUS
  updatedAt             DateTime       @updatedAt @map("updated_at")
  /// 更新人（必填；系統操作帶入使用者 ID；DB 匯入填系統管理員 ID）；啟用最低需求版本：PLUS
  updatedBy             String         @map("updated_by") @db.VarChar(15)
  /// 作廢時間；啟用最低需求版本：PLUS
  voidedAt              DateTime?      @map("voided_at")
  /// 作廢人（使用者 ID）；啟用最低需求版本：PLUS
  voidedBy              String?        @map("voided_by") @db.VarChar(15)
  /// 採購員送審時間（T1-fix 2026-06-07：DRAFT → PENDING_APPROVAL 觸發、與 approvedAt 對稱）
  submittedForReviewAt  DateTime?      @map("submitted_for_review_at")
  /// 採購員送審人（使用者 ID、T1-fix 2026-06-07）
  submittedForReviewBy  String?        @map("submitted_for_review_by") @db.VarChar(15)
  /// 採購組長核准時間。；啟用最低需求版本：PLUS-CORE
  approvedAt            DateTime?      @map("approved_at")
  /// 採購組長核准人（使用者ID）。；啟用最低需求版本：PLUS-CORE
  approvedBy            String?        @map("approved_by") @db.VarChar(15)
  /// 寄出給廠商的時間。；啟用最低需求版本：PLUS-CORE
  sentAt                DateTime?      @map("sent_at")
  /// 廠商確認接單時間，確認後系統自動產生AP應付帳款。；啟用最低需求版本：PLUS-CORE
  supplierConfirmedAt   DateTime?      @map("supplier_confirmed_at")
  /// 退件原因（採購組長退件時填寫）。；啟用最低需求版本：PLUS-CORE
  rejectReason          String?        @map("reject_reason") @db.VarChar(200)
  /// 採購類型（D=國內一般採購/I=國際進口採購/B=掃貨Bulk）。B=掃貨時跳過RF詢價階段，付款條件預設現金/即時匯款，驗收允許多/少貨特殊處理，成本依數量平均攤分。；啟用最低需求版本：LITE-CORE
  purchaseType          String         @default("D") @map("purchase_type") @db.VarChar(1)
  /// 船號（進口採購時，廠商出貨後提供）。；啟用最低需求版本：LITE-CORE
  vesselNo              String?        @map("vessel_no") @db.VarChar(50)
  /// 貨櫃號（進口採購時，廠商出貨後提供）。；啟用最低需求版本：LITE-CORE
  containerNo           String?        @map("container_no") @db.VarChar(50)
  /// 預計到港日 ETA（Estimated Time of Arrival），進口採購時填入。；啟用最低需求版本：LITE-CORE
  eta                   DateTime?      @db.Date
  /// 本張採購單的進口付款條件（TT/LC/DP/DA），從廠商主檔預設帶入，可手動覆蓋。僅進口採購（purchase_type=I）時使用。；啟用最低需求版本：LITE-CORE
  paymentTermImport     String?        @map("payment_term_import") @db.VarChar(5)
  /// 本張採購單的國內付款條件（PREPAY/NET30/NET60/NET90/INSTALLMENT），從廠商主檔 nx01_partner.payment_term_domestic 預設帶入，可手動覆蓋。國內採購（purchase_type=D/B）時使用。NX02-IMPL-01 Phase 1 M1 補齊（既有僅 import 對應、業界需求補國內）。；啟用最低需求版本：LITE-CORE
  paymentTermDomestic   String?        @map("payment_term_domestic") @db.VarChar(10)
  /// 本張採購單的貿易條件（FOB/CIF/EXW/DDP等），從廠商主檔預設帶入，可手動覆蓋。影響 nx02_rr_import 中進口費用欄位的必填判斷：FOB/EXW需填運費；CIF運費由賣方含；DDP所有費用由賣方含。；啟用最低需求版本：LITE-CORE
  incoterm              String?        @default("FOB") @db.VarChar(5)
  /// 國外採購 6 階段追蹤（purchase_type=I 專屬、null=非國外採購、SmallInt 對齊 NX01-17 enum 範式）：1=備貨中 / 2=要求付款 / 3=待出貨（已付款）/ 4=出貨上船 / 5=已到港 / 6=驗收完成。application 層 guard strict 順序流轉（Crown Q-C3=A）。NX02-IMPL-01 Phase 1 M2 新增。；啟用最低需求版本：LITE-CORE
  purchaseStage         Int?           @map("purchase_stage") @db.SmallInt
  /// 廠商要求付款時間（stage=2 觸發、廠商 email 通知）；啟用最低需求版本：LITE-CORE
  requestedPaymentAt    DateTime?      @map("requested_payment_at")
  /// 實際付款時間（stage=3 觸發、付款完成）；啟用最低需求版本：LITE-CORE
  paidAt                DateTime?      @map("paid_at")
  /// 上船時間（stage=4 觸發、配既有 vessel_no / container_no）；啟用最低需求版本：LITE-CORE
  shippedAt             DateTime?      @map("shipped_at")
  /// 實際到港時間（stage=5 觸發、報關行 email 通知、相對既有 eta 預計時間）；啟用最低需求版本：LITE-CORE
  arrivedAt             DateTime?      @map("arrived_at")
  /// T6 進貨對齊批次 2026-06-08：國內物流追蹤編號（黑貓 / 嘉里 / 大榮 / 新竹 等）。
  /// purchase_type=D/B 時用；UI 在採購單詳細頁顯示供採購員追蹤包裹。；啟用最低需求版本：LITE-CORE
  domesticTrackingNo    String?        @map("domestic_tracking_no") @db.VarChar(50)
  /// T6 進貨對齊批次 2026-06-08：付款里程碑（國內外通用）。
  /// null=未啟動 / N=廠商通知付款 / D=已付。國外既有 paidAt 是 stage=3 觸發、語意不同不複用。；啟用最低需求版本：LITE-CORE
  paymentMilestone      String?        @map("payment_milestone") @db.VarChar(1)
  /// T6 進貨對齊批次 2026-06-08：帳款年月（YYYY-MM、月結用、寫入 AP 帳期歸戶）。
  /// 預設由建單日 + 付款條件推算（如 NET30 = 建單月+1）、可手動覆寫。；啟用最低需求版本：LITE-CORE
  apMonth               String?        @map("ap_month") @db.VarChar(7)
  /// T6 進貨對齊批次 2026-06-08：報關行廠商（國外採購用、FK nx01_partner、partnerType='T' 外包物流、application 層 guard）。；啟用最低需求版本：LITE-CORE
  customsAgentPartnerId String?        @map("customs_agent_partner_id") @db.VarChar(15)
  /// T7 進貨對齊批次 2026-06-08：付款對象（FK partner、null = 跟 supplier 同）。
  /// 業務語意：母公司付款 / 集團代付。發票對此 partner 開、AP 帳目對此 partner 歸戶。；啟用最低需求版本：LITE-CORE
  invoiceToPartnerId    String?        @map("invoice_to_partner_id") @db.VarChar(15)
  /// T7 進貨對齊批次 2026-06-08：指送對象（FK partner、null = 跟 supplier 同 / 我方收貨）。
  /// 業務語意：分店收貨（指定我方分店 partner）/ 直送客戶現場（指定 customer partner、不進倉）。；啟用最低需求版本：LITE-CORE
  shipToPartnerId       String?        @map("ship_to_partner_id") @db.VarChar(15)
  /// T7 進貨對齊批次 2026-06-08：收貨地址（FK nx01_partner_address、應屬 shipToPartnerId 或 supplier）。
  /// null = 用 partner 預設地址。application 層守 partnerId 一致。；啟用最低需求版本：LITE-CORE
  shipToAddressId       String?        @map("ship_to_address_id") @db.VarChar(15)
  /// T7 進貨對齊批次 2026-06-08：交貨地點（自由文字、直送客戶現場用、覆寫 shipToAddressId）。
  /// 業務語意：臨時工地、會場、客戶口頭指定的地址、不必入主檔。；啟用最低需求版本：LITE-CORE
  deliveryAddress       String?        @map("delivery_address") @db.VarChar(200)
  tenant                Nx99Tenant     @relation("R_Nx02Po_tenantId", fields: [tenantId], references: [id])
  supplier              Nx01Partner    @relation("R_Nx02Po_supplierId", fields: [supplierId], references: [id])
  customsAgent          Nx01Partner?   @relation("R_Nx02Po_customsAgentPartnerId", fields: [customsAgentPartnerId], references: [id])
  invoiceToPartner      Nx01Partner?   @relation("R_Nx02Po_invoiceToPartnerId", fields: [invoiceToPartnerId], references: [id])
  shipToPartner         Nx01Partner?   @relation("R_Nx02Po_shipToPartnerId", fields: [shipToPartnerId], references: [id])
  shipToAddress         Nx01PartnerAddress? @relation("R_Nx02Po_shipToAddressId", fields: [shipToAddressId], references: [id])
  rfq                   Nx02Rfq?       @relation("R_Nx02Po_rfqId", fields: [rfqId], references: [id])
  rev_Nx02PoItem_poId   Nx02PoItem[]   @relation("R_Nx02PoItem_poId")
  rev_Nx02Rr_poId       Nx02Rr[]       @relation("R_Nx02Rr_poId")
  rev_Nx02RrImport_poId Nx02RrImport[] @relation("R_Nx02RrImport_poId")
  rev_Nx05ApLedger_poId Nx05ApLedger[] @relation("R_Nx05ApLedger_poId")

  @@unique([docNo])
  @@index([customsAgentPartnerId])
  @@index([invoiceToPartnerId])
  @@index([shipToPartnerId])
  @@index([shipToAddressId])
  @@map("nx02_po")
}

/// =======================================================
/// Nx02PoItem — DB table `nx02_po_item`
/// =======================================================
model Nx02PoItem {
  /// [NX02]+[POIT]+[7碼流水號]，EX : NX02POIT0000001；啟用最低需求版本：PLUS
  id           String       @id @default(dbgenerated("gen_nx02_po_item_id()")) @db.VarChar(15)
  /// 對應採購單表頭 ID；啟用最低需求版本：PLUS
  poId         String       @map("po_id") @db.VarChar(15)
  /// 詢價明細 ID (外鍵) (可空)；啟用最低需求版本：PLUS
  rfqItemId    String?      @map("rfq_item_id") @db.VarChar(15)
  /// 明細行號（1,2,3…）；啟用最低需求版本：PLUS
  lineNo       Int          @default(1) @map("line_no")
  /// 零件 ID；啟用最低需求版本：PLUS
  partId       String       @map("part_id") @db.VarChar(15)
  /// 零件料號快照（避免主檔變更影響歷史）；啟用最低需求版本：PLUS
  partNo       String       @map("part_no") @db.VarChar(50)
  /// 零件名稱快照；啟用最低需求版本：PLUS
  partName     String       @map("part_name") @db.VarChar(200)
  /// 採購數量；啟用最低需求版本：PLUS
  qty          Decimal      @default(0) @db.Decimal(14, 4)
  /// 已收數量（預設 0，RR 過帳時累加）；啟用最低需求版本：PLUS
  receivedQty  Decimal      @default(0) @map("received_qty") @db.Decimal(14, 4)
  /// 03 收尾 A 2026-06-08：取消量（部分進貨後採購員可取消剩餘量、把單收掉）。剩餘可收 = qty - receivedQty - cancelledQty；當所有 line 剩餘=0、可結案 PO。；啟用最低需求版本：LITE-CORE
  cancelledQty Decimal      @default(0) @map("cancelled_qty") @db.Decimal(14, 4)
  /// 採購單價；啟用最低需求版本：PLUS
  unitCost     Decimal      @default(0) @map("unit_cost") @db.Decimal(14, 4)
  /// 明細金額（qty * unit_cost）；啟用最低需求版本：PLUS
  lineAmount   Decimal      @default(0) @map("line_amount") @db.Decimal(14, 2)
  /// 預計到貨日；啟用最低需求版本：PLUS
  expectedDate DateTime?    @map("expected_date") @db.Date
  /// 備註；啟用最低需求版本：PLUS
  remark       String?      @db.VarChar(200)
  /// 建立時間。；啟用最低需求版本：PLUS
  createdAt    DateTime     @default(now()) @map("created_at")
  /// 建立人（必填；系統操作帶入使用者 ID；DB 匯入填系統管理員 ID）；啟用最低需求版本：PLUS
  createdBy    String       @map("created_by") @db.VarChar(15)
  /// 更新時間。；啟用最低需求版本：PLUS
  updatedAt    DateTime     @updatedAt @map("updated_at")
  /// 更新人（必填；系統操作帶入使用者 ID；DB 匯入填系統管理員 ID）；啟用最低需求版本：PLUS
  updatedBy    String       @map("updated_by") @db.VarChar(15)
  po           Nx02Po       @relation("R_Nx02PoItem_poId", fields: [poId], references: [id])
  rfqItem      Nx02RfqItem? @relation("R_Nx02PoItem_rfqItemId", fields: [rfqItemId], references: [id])
  part         Nx01Part     @relation("R_Nx02PoItem_partId", fields: [partId], references: [id])

  @@map("nx02_po_item")
}

/// =======================================================
/// Nx02Pr — DB table `nx02_pr`
/// =======================================================
model Nx02Pr {
  /// [NX02]+[PRHT]+[7碼流水號]，EX : NX02PRHT0000001；啟用最低需求版本：LITE
  id                    String         @id @default(dbgenerated("gen_nx02_pr_id()")) @db.VarChar(15)
  /// 租戶ID；啟用最低需求版本：LITE
  tenantId              String         @map("tenant_id") @db.VarChar(15)
  /// 退貨倉庫 ID；啟用最低需求版本：LITE
  warehouseId           String         @map("warehouse_id") @db.VarChar(15)
  /// 退貨單號（唯一），[PR]+[年月]+[倉別]+[5碼流水號]，EX：PR-202602-Z01-00001；啟用最低需求版本：LITE
  docNo                 String         @map("doc_no") @db.VarChar(30)
