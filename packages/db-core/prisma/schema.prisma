model Nx01Part {
  /// [NX01]+[PART]+[7碼流水號]，EX : NX01PART0000001；啟用最低需求版本：LITE
  id                              String                 @id @default(dbgenerated("gen_nx01_part_id()")) @db.VarChar(15)
  /// 租戶 ID（外鍵）；啟用最低需求版本：LITE
  tenantId                        String                 @map("tenant_id") @db.VarChar(15)
  /// 基準料號（客戶自訂、純手動輸入、必填、開放修改；2026-06-26 分段編碼規則已廢）；啟用最低需求版本：LITE
  code                            String                 @db.VarChar(50)
  /// 零件名稱/品名（例：機油濾芯）；啟用最低需求版本：LITE
  name                            String                 @db.VarChar(200)
  /// 是否為正廠件；啟用最低需求版本：LITE
  isOem                           Boolean                @default(true) @map("is_oem")
  /// 廠牌料號（記「該廠牌對這料件的料號」、可能原廠可能副廠；2026-06-26 改必填 NOT NULL：基準料號+廠牌料號皆必填）。；啟用最低需求版本：LITE
  secCode                         String                 @map("sec_code") @db.VarChar(50)
  /// 成本（業務員填、價格重算基準、下半場 B）；啟用最低需求版本：LITE
  cost                            Decimal?               @default(0) @db.Decimal(14, 4)
  /// 產地 (外鍵)；啟用最低需求版本：LITE
  countryId                       String?                @map("country_id") @db.VarChar(15)
  /// 品牌 ID（FK nx01_brand、可空 = 部分料號尚未補齊）；啟用最低需求版本：LITE
  /// W6 [3-8] Phase 5 2026-06-06 品牌合併：取代舊 partBrandId
  brandId                         String?                @map("brand_id") @db.VarChar(15)
  /// 零件類型 (1=專用型 / 2=通用型 / 3=組合型 / 4=拆解型、軸 1 升 SmallInt、對齊 NX01-14/15 範式)；啟用最低需求版本：LITE
  type                            Int?                   @default(1) @db.SmallInt
  /// 零件種類 id (外鍵、分類三＝客戶自定義群組)；啟用最低需求版本：LITE
  partGroupId                     String?                @map("part_group_id") @db.VarChar(15)
  /// 分類一・採購角度（選填、寫死 SmallInt：1=保養件 / 2=維修件 / 3=事故件 / 4=改裝件 / 5=油品耗材；2026-06-26 新增）；啟用最低需求版本：LITE
  purchaseCategory                Int?                   @map("purchase_category") @db.SmallInt
  /// 分類二・技術角度（選填、寫死 SmallInt：1=引擎動力 / 2=傳動 / 3=制動 / 4=轉向 / 5=懸吊底盤 / 6=電氣電子 / 7=冷卻空調 / 8=車體內外裝 / 9=安全輔助；2026-06-26 新增）；啟用最低需求版本：LITE
  techCategory                    Int?                   @map("tech_category") @db.SmallInt
  /// 規格/備註（例：MANN / 含墊片 / 06L…適用）；啟用最低需求版本：LITE
  spec                            String?                @db.VarChar(200)
  /// 單位（LITE 固定單位即可；未來再做多單位換算）；啟用最低需求版本：LITE
  uom                             String                 @default("pcs") @db.VarChar(10)
  /// 是否啟用（下架不刪資料）；啟用最低需求版本：LITE
  isActive                        Boolean                @default(true) @map("is_active")
  /// 建立時間。；啟用最低需求版本：LITE
  createdAt                       DateTime               @default(now()) @map("created_at")
  /// 建立人（必填；系統操作帶入使用者 ID；DB 匯入填系統管理員 ID）；啟用最低需求版本：LITE
  createdBy                       String                 @map("created_by") @db.VarChar(15)
  /// 更新時間。；啟用最低需求版本：LITE
  updatedAt                       DateTime               @updatedAt @map("updated_at")
  /// 更新人（必填；系統操作帶入使用者 ID；DB 匯入填系統管理員 ID）；啟用最低需求版本：LITE
  updatedBy                       String                 @map("updated_by") @db.VarChar(15)
  /// 退貨政策（02 第三批 T3 2026-06-07 簡化三選項：N=不可退不保固 / S=未使用可退 / W=走保固流程）。
  /// 舊 5 值（F=自由退貨 / R=限制退貨）保留兼容歷史資料、UI 不再顯示。
  /// 搭配 warranty_months：W 走保固流程時、進貨驗收依此計算保固到期日。實際退貨運作邏輯留 NX04/NX05。；啟用最低需求版本：LITE-CORE
  returnPolicy                    String                 @default("S") @map("return_policy") @db.VarChar(1)
  /// 保固月數，0=不保固。進貨驗收時系統依此計算保固到期日（warranty_expired_at）並寫入進貨明細。；啟用最低需求版本：LITE-CORE
  warrantyMonths                  Int                    @default(0) @map("warranty_months")
  /// A 級建議售價（最優客戶，由採購組長在產品分析設定）。；啟用最低需求版本：LITE-CORE
  priceA                          Decimal?               @default(0) @map("price_a") @db.Decimal(14, 4)
  /// B 級建議售價（由採購組長在產品分析設定）。；啟用最低需求版本：LITE-CORE
  priceB                          Decimal?               @default(0) @map("price_b") @db.Decimal(14, 4)
  /// C 級建議售價（由採購組長在產品分析設定）。；啟用最低需求版本：LITE-CORE
  priceC                          Decimal?               @default(0) @map("price_c") @db.Decimal(14, 4)
  /// D 級建議售價（一般客戶，由採購組長在產品分析設定）。；啟用最低需求版本：LITE-CORE
  priceD                          Decimal?               @default(0) @map("price_d") @db.Decimal(14, 4)
  /// 建議售價最後更新時間。；啟用最低需求版本：LITE-CORE
  priceUpdatedAt                  DateTime?              @map("price_updated_at")
  /// 建議售價最後更新人（採購組長，使用者ID）。；啟用最低需求版本：LITE-CORE
  priceUpdatedBy                  String?                @map("price_updated_by") @db.VarChar(15)
  /// 最後進貨時間（驗收入庫過帳時自動寫、取單據業務日期 inboundDate；02 第四批 軌 3b 2026-06-07 新增）
  /// 業務員業績指標：看「最後一次進貨」是何時、判斷補貨節奏。
  /// 寫入點：Nx03Inbound 從 INSPECTING → POSTED 時、applyInboundPosting 內 ledger 寫完後更新（取 max 防舊單覆蓋新單）。
  lastPurchaseAt                  DateTime?              @map("last_purchase_at")
  /// 最後銷售時間（出貨過帳時自動寫、取單據業務日期 outboundDate；02 第四批 軌 3b 2026-06-07 新增）
  /// 業務員業績指標：看「最後一次賣出」是何時、判斷滯銷風險。
  /// 寫入點：Nx03Outbound 從 PACKED → SHIPPED 時、applyOutboundShipping 內 ledger 寫完後更新（取 max 防舊單覆蓋新單）。
  lastSaleAt                      DateTime?              @map("last_sale_at")
  /// 建議保存期限（月、選填、可覆寫族群 default、空=取族群預設）；02 第四批 軌 6 2026-06-07 新增
  /// 繼承+覆寫範式同客戶分級加成率 + Partner.customMarginPct：
