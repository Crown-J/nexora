  /// 完成交接時間；啟用最低需求版本：LITE-CORE
  completedAt     DateTime?  @map("completed_at")
  /// 建立時間；啟用最低需求版本：LITE-CORE
  createdAt       DateTime   @default(now()) @map("created_at")
  /// 更新時間；啟用最低需求版本：LITE-CORE
  updatedAt       DateTime   @updatedAt @map("updated_at")
  /// 更新人；啟用最低需求版本：LITE-CORE
  updatedBy       String     @map("updated_by") @db.VarChar(15)
  dn              Nx06Dn     @relation("R_Nx06DnHandover_dnId", fields: [dnId], references: [id])
  fromDriver      Nx01User   @relation("R_Nx06DnHandover_fromDriverId", fields: [fromDriverId], references: [id])
  toDriver        Nx01User   @relation("R_Nx06DnHandover_toDriverId", fields: [toDriverId], references: [id])
  tenant          Nx99Tenant @relation("R_Nx06DnHandover_tenantId", fields: [tenantId], references: [id])

  @@index([dnId], map: "idx_handover_dn")
  @@index([tenantId, status], map: "idx_handover_status")
  @@map("nx06_dn_handover")
}

