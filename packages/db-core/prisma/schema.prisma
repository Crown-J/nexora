/// =======================================================
model Nx02Rfq {
  /// [NX02]+[RFHT]+[7碼流水號]，EX : NX02RFHT0000001；啟用最低需求版本：LITE
  id                        String         @id @default(dbgenerated("gen_nx02_rfq_id()")) @db.VarChar(15)
  /// 租戶ID；啟用最低需求版本：LITE
  tenantId                  String         @map("tenant_id") @db.VarChar(15)
  /// 詢價單號（唯一），[RF]+[年月]+[倉別]+[5碼流水號]，EX：RF-202602-Z01-00001；啟用最低需求版本：LITE
  docNo                     String         @map("doc_no") @db.VarChar(30)
  /// 詢價日期；啟用最低需求版本：LITE
  rfqDate                   DateTime       @map("rfq_date") @db.Date
  /// 主供應商（交易對象 ID、可空：LITE 階段 1 簡化詢價範式 = 系統不預先綁供應商名單、業務複製詢價文字到外部問、回價時記錄到 Nx02Qt；本欄位保留作「優先意向供應商」可選欄、application 層 guard partner_type='S' 純供應商）；啟用最低需求版本：LITE
  supplierId                String?        @map("supplier_id") @db.VarChar(15)
  /// 聯絡人（可空，臨時覆寫 partner 主檔）；啟用最低需求版本：LITE
  contactName               String?        @map("contact_name") @db.VarChar(50)
  /// 聯絡電話（可空）；啟用最低需求版本：LITE
  contactPhone              String?        @map("contact_phone") @db.VarChar(30)
  /// 幣別（LITE 預設 TWD）；啟用最低需求版本：LITE
  currency                  String         @default("TWD") @db.VarChar(10)
  /// 狀態。(D=DRAFT, S=SENT, R=REPLIED, C=CLOSED, V=VOID)；啟用最低需求版本：LITE
  status                    String         @default("DRAFT") @db.VarChar(20)
  /// 備註；啟用最低需求版本：LITE
  remark                    String?        @db.VarChar(200)
  /// 建立時間。；啟用最低需求版本：LITE
  createdAt                 DateTime       @default(now()) @map("created_at")
  /// 建立人（必填；系統操作帶入使用者 ID；DB 匯入填系統管理員 ID）；啟用最低需求版本：LITE
  createdBy                 String         @map("created_by") @db.VarChar(15)
  /// 更新時間。；啟用最低需求版本：LITE
  updatedAt                 DateTime       @updatedAt @map("updated_at")
  /// 更新人（必填；系統操作帶入使用者 ID；DB 匯入填系統管理員 ID）；啟用最低需求版本：LITE
  updatedBy                 String         @map("updated_by") @db.VarChar(15)
  /// 作廢時間。；啟用最低需求版本：LITE
  voidedAt                  DateTime?      @map("voided_at")
  /// 作廢人（使用者 ID）；啟用最低需求版本：LITE
  voidedBy                  String?        @map("voided_by") @db.VarChar(15)
  /// 詢價類型（G=一般詢價：採購多家供應商比價工具/P=同行調貨詢價：銷售業務調貨用）。LITE 階段 1 範式：G 型 = 業務從料件+數量發起→產生詢價文字→自己拿去 LINE/電話問→回價填入 Nx02Qt（partner_type=S 純供應商）並排比價→選一家開 PO；P 型既有同行調貨範式不變（Qt.partner_type=O 同行）後續只能建立調貨單 TI 不能建立 PO。；啟用最低需求版本：LITE-CORE
  rfqType                   String         @default("G") @map("rfq_type") @db.VarChar(1)
  /// 詢價原因（可複選，逗號分隔）：S=庫存不足/O=客訂/N=新品/P=特價/T=同行調貨。同行調貨詢價固定為T不可修改。；啟用最低需求版本：LITE-CORE
  rfqReason                 String?        @map("rfq_reason") @db.VarChar(50)
  /// 入庫倉庫ID（影響單號產生，FK nx02_warehouse）。；啟用最低需求版本：LITE-CORE
  warehouseId               String         @map("warehouse_id") @db.VarChar(15)
  /// 詢價有效期限。同廠商同料號有新詢價單時舊的自動失效。過期後不得用來建立採購單。；啟用最低需求版本：LITE-CORE
  validUntil                DateTime?      @map("valid_until") @db.Date
  /// 來源採購需求單ID（可空，從採購需求單發起時填入）。；啟用最低需求版本：LITE-CORE
  demandId                  String?        @map("demand_id") @db.VarChar(15)
  /// 來源 SO line item ID（D4 translator 建同行調貨 RFQ stub 時填入，B5 採用 QT 後反查 SO line item 用）。一般詢價（rfqType='G'）為空。；啟用最低需求版本：LITE-CORE
  sourceSoItemId            String?        @map("source_so_item_id") @db.VarChar(15)
  tenant                    Nx99Tenant     @relation("R_Nx02Rfq_tenantId", fields: [tenantId], references: [id])
  supplier                  Nx01Partner?   @relation("R_Nx02Rfq_supplierId", fields: [supplierId], references: [id])
  warehouse                 Nx01Warehouse  @relation("R_Nx02Rfq_warehouseId", fields: [warehouseId], references: [id])
  demand                    Nx02Demand?    @relation("R_Nx02Rfq_demandId", fields: [demandId], references: [id])
  sourceSoItem              Nx04SoItem?    @relation("R_Nx02Rfq_sourceSoItemId", fields: [sourceSoItemId], references: [id])
  rev_Nx02Demand_refRfqId   Nx02Demand[]   @relation("R_Nx02Demand_refRfqId")
  rev_Nx02Po_rfqId          Nx02Po[]       @relation("R_Nx02Po_rfqId")
  rev_Nx02Qt_rfqId          Nx02Qt[]       @relation("R_Nx02Qt_rfqId")
  rev_Nx02RfqItem_rfqId     Nx02RfqItem[]  @relation("R_Nx02RfqItem_rfqId")
  rev_Nx02Rr_rfqId          Nx02Rr[]       @relation("R_Nx02Rr_rfqId")
  rev_Nx02Ti_rfqId          Nx02Ti[]       @relation("R_Nx02Ti_rfqId")
  rev_Nx03Shortage_refRfqId Nx03Shortage[] @relation("R_Nx03Shortage_refRfqId")
  rev_Nx04Quote_rfqId       Nx04Quote[]    @relation("R_Nx04Quote_rfqId")

  @@unique([docNo])
  @@index([tenantId, sourceSoItemId], map: "nx02_rfq_tenant_source_so_item_idx")
  @@map("nx02_rfq")
}

